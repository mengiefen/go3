<div class="p-8">
  <h1 class="text-2xl font-bold mb-4">Controller Test Page</h1>
  
  <div class="mb-8">
    <h2 class="text-xl font-semibold mb-2">Available Controllers:</h2>
    <ul id="controller-list" class="list-disc pl-6"></ul>
  </div>
  
  <div class="mb-8">
    <h2 class="text-xl font-semibold mb-2">Test Navigation Sidebar:</h2>
    <div class="border border-gray-300 p-4" 
         data-controller="reusable-navigation-sidebar"
         data-reusable-navigation-sidebar-collapsible-value="true">
      <div data-reusable-navigation-sidebar-target="category">
        <button class="flex items-center space-x-2 p-2 bg-gray-100 rounded"
                data-action="click->reusable-navigation-sidebar#toggleCategory"
                data-category-index="0">
          <span>Test Category</span>
          <span data-reusable-navigation-sidebar-target="chevron">▶</span>
        </button>
        <div data-reusable-navigation-sidebar-target="categoryContent" class="pl-4 mt-2">
          <div class="p-2 hover:bg-gray-100 cursor-pointer"
               data-action="click->reusable-navigation-sidebar#openTab"
               data-content-type="test"
               data-content-id="1"
               data-content-name="Test Item">
            Test Item 1
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <div class="mb-8">
    <h2 class="text-xl font-semibold mb-2">Test Tab System:</h2>
    <div data-controller="tab-system reusable-tabs"
         data-tab-system-theme-value="vscode"
         class="border border-gray-300 p-4">
      <div data-tab-system-target="tabBar">Tab bar will appear here</div>
      <div data-tab-system-target="contentAreas">Content will appear here</div>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
  // List all registered controllers
  const app = window.Stimulus?.application;
  if (app) {
    const controllers = app.controllers.map(c => c.identifier);
    const list = document.getElementById('controller-list');
    controllers.forEach(name => {
      const li = document.createElement('li');
      li.textContent = name;
      list.appendChild(li);
    });
  }
  
  // Log controller connections
  console.log('=== Controller Test Page Loaded ===');
  setTimeout(() => {
    const navController = app?.getControllerForElementAndIdentifier(
      document.querySelector('[data-controller*="reusable-navigation-sidebar"]'),
      'reusable-navigation-sidebar'
    );
    console.log('Navigation controller:', navController);
    
    const tabSystemController = app?.getControllerForElementAndIdentifier(
      document.querySelector('[data-controller*="tab-system"]'),
      'tab-system'
    );
    console.log('Tab system controller:', tabSystemController);
    
    const reusableTabsController = app?.getControllerForElementAndIdentifier(
      document.querySelector('[data-controller*="reusable-tabs"]'),
      'reusable-tabs'
    );
    console.log('Reusable tabs controller:', reusableTabsController);
  }, 1000);
});
</script>