<!-- Mobile Layout -->
<div class="lg:hidden" data-controller="mobile-demo">
  <% active_tab = params[:mobile_tab] || 'home' %>
  
  <%= render MobileLayout::Component.new(active_tab: active_tab) do |layout| %>
    <% layout.with_main_content do %>
      <% case active_tab %>
      <% when 'home' %>
        <%= render MobileHome::Component.new(
          user_name: "Alex",
          org_count: 8,
          task_count: 12,
          recent_orgs: [
            { id: 1, name: "Global Tech Solutions", member_count: 324, logo_url: nil },
            { id: 2, name: "Acme Manufacturing", member_count: 186, logo_url: nil }
          ],
          today_tasks: [
            { title: "Review Q4 financial reports", time: "9:30 AM" },
            { title: "Department budget meeting", time: "1:00 PM" },
            { title: "Process employee onboarding", time: "3:30 PM" },
            { title: "Update inventory levels" }
          ]
        ) %>
      <% when 'orgs' %>
        <%= render MobileOrganizations::Component.new(
          organizations: [
            { id: 1, name: "Global Tech Solutions", description: "Enterprise technology and consulting services", member_count: 324, status: 'active', favorite: true },
            { id: 2, name: "Acme Manufacturing Corp", description: "Industrial manufacturing and supply chain", member_count: 186, status: 'active' },
            { id: 3, name: "FinanceFlow LLC", description: "Financial services and accounting", member_count: 67, status: 'active' },
            { id: 4, name: "RetailMax Industries", description: "Retail operations and inventory management", member_count: 142, status: 'active' },
            { id: 5, name: "Healthcare Systems Inc", description: "Medical equipment and healthcare solutions", member_count: 298, status: 'active' },
            { id: 6, name: "Logistics Pro", description: "Transportation and logistics coordination", member_count: 89, status: 'pending' }
          ],
          active_org_id: 1,
          can_create: true
        ) %>
      <% when 'tasks' %>
        <%= render MobileTasks::Component.new(
          tasks: [
            { id: 1, title: "Process Q4 Financial Audit", description: "Review and approve quarterly financial statements for compliance", status: 'pending', priority: 'high', due_date: Date.today, tags: ['finance', 'audit'] },
            { id: 2, title: "Update Employee Payroll", description: "Process monthly payroll for Global Tech Solutions", status: 'in_progress', priority: 'urgent', due_date: Date.today, assignee: { name: 'You' } },
            { id: 3, title: "Inventory Count - Warehouse A", description: "Conduct monthly inventory count for manufacturing items", status: 'pending', priority: 'medium', due_date: Date.today + 1, tags: ['inventory', 'warehouse'] },
            { id: 4, title: "Review Department Budgets", description: "Analyze and approve budget requests for Q1 2025", status: 'pending', priority: 'high', due_date: Date.today + 3, assignee: { name: 'Sarah Wilson' } },
            { id: 5, title: "Complete Employee Onboarding", description: "Process new hire documentation for 3 employees", status: 'in_progress', priority: 'medium', due_date: Date.today + 2, tags: ['hr', 'onboarding'] },
            { id: 6, title: "Generate Monthly Reports", description: "Create financial and operational reports for stakeholders", status: 'completed', priority: 'low', due_date: Date.today - 2, tags: ['reports'] }
          ],
          filter: params[:filter] || 'all',
          current_user: { id: 1 }
        ) %>
      <% when 'team' %>
        <%= render MobileTeam::Component.new(
          team_members: [
            { id: 1, name: "Alex Rodriguez", role: "Operations Manager", department: "Operations", is_online: true },
            { id: 2, name: "Sarah Mitchell", role: "Financial Controller", department: "Finance", is_online: true },
            { id: 3, name: "Marcus Chen", role: "HR Director", department: "Human Resources", is_online: false },
            { id: 4, name: "Jennifer Walsh", role: "Supply Chain Manager", department: "Operations", status: 'away' },
            { id: 5, name: "David Thompson", role: "Accountant", department: "Finance", is_online: false },
            { id: 6, name: "Rachel Kim", role: "HR Specialist", department: "Human Resources", is_online: true },
            { id: 7, name: "Antonio Silva", role: "Inventory Manager", department: "Operations", is_online: true },
            { id: 8, name: "Michelle Carter", role: "Payroll Specialist", department: "Finance", is_online: false },
            { id: 9, name: "Robert Zhang", role: "Compliance Officer", department: "Legal", is_online: true },
            { id: 10, name: "Amanda Foster", role: "Department Head", department: "Operations", is_online: true }
          ],
          departments: [
            { name: "Operations", member_count: 4 },
            { name: "Finance", member_count: 3 },
            { name: "Human Resources", member_count: 2 },
            { name: "Legal", member_count: 1 }
          ],
          current_user: { id: 1 }
        ) %>
      <% when 'more' %>
        <%= render MobileMore::Component.new(
          user: { name: "Alex Rodriguez", email: "alex.rodriguez@globaltechsolutions.com" }
        ) %>
      <% end %>
    <% end %>
  <% end %>
</div>

<!-- Desktop Layout -->
<div class="hidden lg:flex h-screen flex-col bg-slate-50 dark:bg-slate-900">
  
  <!-- Fixed Header - only visible on desktop -->
  <header class="hidden lg:flex fixed top-0 left-0 right-0 h-12 bg-white dark:bg-slate-800 text-slate-900 dark:text-white z-50 items-center px-4 shadow-lg border-b border-slate-200 dark:border-slate-700">
    <div class="flex items-center space-x-4">
      <!-- Logo/Brand -->
      <div class="flex items-center">
        <%= image_tag "logo.png", alt: "GO3 Platform", class: "h-8 w-auto" %>
      </div>
    </div>
    
    <!-- Center section - could be used for breadcrumbs or current context -->
    <div class="flex-1 flex items-center justify-center">
      <span class="text-xs text-slate-500 dark:text-slate-400">Reusable Components Demo</span>
    </div>
    
    <!-- Right section - user info and actions -->
    <div class="flex items-center space-x-3">
      <!-- Settings -->
      <button class="p-1.5 rounded hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors" title="Settings">
        <svg class="w-4 h-4 text-slate-600 dark:text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
        </svg>
      </button>
      
      <!-- Notifications -->
      <button class="p-1.5 rounded hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors relative" title="Notifications">
        <svg class="w-4 h-4 text-slate-600 dark:text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path>
        </svg>
        <span class="absolute top-0 right-0 block h-2 w-2 bg-blue-500 rounded-full"></span>
      </button>
      
      <!-- User Profile -->
      <div class="flex items-center space-x-2 pl-3 border-l border-slate-300 dark:border-slate-700">
        <div class="w-7 h-7 bg-gradient-to-br from-blue-400 to-blue-600 rounded-full flex items-center justify-center text-xs font-medium text-white">
          U
        </div>
        <span class="text-sm text-slate-700 dark:text-slate-300">User</span>
      </div>
    </div>
  </header>
  
  <!-- Main content area with responsive padding -->
  <div class="flex flex-1 pt-16 lg:pt-12 pb-16 lg:pb-0 bg-slate-50 dark:bg-slate-900 relative">
    <!-- Primary Icon Sidebar - visible on tablet and desktop -->
    <div class="hidden sm:block">
      <%= render(IconSidebar::Component.new(active_item: nil)) %>
    </div>
  
    <!-- Secondary Sidebar - hidden on mobile/tablet, shown as overlay when triggered -->
    <%= render ResizablePanel::Component.new(
      direction: :horizontal,
      min_size: 200,
      max_size: 600,
      default_size: 300,
      handle_position: :end,
      persist_size: true,
      storage_key: 'reusable_secondary_sidebar',
      classes: 'hidden lg:block border-r border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800'
    ) do %>
      <div id="secondary-sidebar">
        <%= render NavigationSidebar::Component.new(
          navigation_type: 'organizations',
          collapsible: true,
          search_enabled: false,
          controller_name: "reusable-navigation-sidebar"
        ) %>
      </div>
    <% end %>
  
    <!-- Main Content Area with Tab System - hidden on mobile -->
    <%= render TabSystem::Component.new(
      theme: :enterprise,
      show_icons: false,
      show_close_buttons: true,
      allow_reorder: true,
      show_actions_menu: true,
      controller_name: "tab-system",
      classes: "shadow-xl"
    ) %>
    
  </div>
</div>