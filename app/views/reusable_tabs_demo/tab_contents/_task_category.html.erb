<div class="p-8">
  <div class="max-w-4xl mx-auto">
    <div class="bg-white dark:bg-slate-800 rounded-lg shadow-lg overflow-hidden">
      <div class="bg-gradient-to-r from-green-500 to-green-600 p-6 text-white">
        <h1 class="text-2xl font-bold">Task Category: <%= content_id.humanize %></h1>
        <p class="text-green-100 mt-2">Manage tasks in this category</p>
      </div>
      
      <div class="p-6">
        <div class="space-y-4">
          <% (1..8).each do |i| %>
            <div class="border border-slate-200 dark:border-slate-600 rounded-lg p-4 hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors">
              <div class="flex items-center justify-between">
                <div class="flex items-center space-x-3">
                  <div class="w-4 h-4 border-2 border-slate-300 dark:border-slate-600 rounded <%= i <= 3 ? 'bg-green-500 border-green-500' : '' %>"></div>
                  <div>
                    <h4 class="font-medium text-slate-900 dark:text-white">Task #<%= i %> - Complete feature implementation</h4>
                    <p class="text-sm text-slate-500 dark:text-slate-400">Created 2 days ago • Due in <%= rand(1..7) %> days</p>
                  </div>
                </div>
                <div class="flex items-center space-x-2">
                  <span class="px-2 py-1 bg-<%= ['blue', 'green', 'yellow', 'red'].sample %>-100 text-<%= ['blue', 'green', 'yellow', 'red'].sample %>-800 text-xs rounded-full">
                    <%= ['Low', 'Medium', 'High', 'Urgent'].sample %>
                  </span>
                  <span class="px-2 py-1 bg-slate-100 dark:bg-slate-600 text-slate-800 dark:text-slate-200 text-xs rounded-full">
                    <%= ['Todo', 'In Progress', 'Review', 'Done'].sample %>
                  </span>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>