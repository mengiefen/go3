<div class="p-6 bg-white dark:bg-slate-900">
  <div class="flex items-center space-x-3 mb-6">
    <div class="w-8 h-8 bg-orange-100 dark:bg-orange-900 rounded-lg flex items-center justify-center">
      <svg class="w-5 h-5 text-orange-600 dark:text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
      </svg>
    </div>
    <div>
      <h1 class="text-xl font-semibold text-slate-900 dark:text-white">Report: <%= params[:content_name] || content_id %></h1>
      <p class="text-sm text-slate-500 dark:text-slate-400">Analytics report and data insights</p>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
    <div class="bg-gradient-to-r from-blue-50 to-blue-100 dark:from-blue-900/20 dark:to-blue-800/20 rounded-lg p-4">
      <h3 class="font-medium text-blue-900 dark:text-blue-100 mb-2">Total Revenue</h3>
      <div class="text-2xl font-bold text-blue-700 dark:text-blue-300">$124,350</div>
      <p class="text-xs text-blue-600 dark:text-blue-400">+18% from last month</p>
    </div>
    
    <div class="bg-gradient-to-r from-green-50 to-green-100 dark:from-green-900/20 dark:to-green-800/20 rounded-lg p-4">
      <h3 class="font-medium text-green-900 dark:text-green-100 mb-2">Active Users</h3>
      <div class="text-2xl font-bold text-green-700 dark:text-green-300">8,420</div>
      <p class="text-xs text-green-600 dark:text-green-400">+12% from last month</p>
    </div>
    
    <div class="bg-gradient-to-r from-purple-50 to-purple-100 dark:from-purple-900/20 dark:to-purple-800/20 rounded-lg p-4">
      <h3 class="font-medium text-purple-900 dark:text-purple-100 mb-2">Conversion Rate</h3>
      <div class="text-2xl font-bold text-purple-700 dark:text-purple-300">3.2%</div>
      <p class="text-xs text-purple-600 dark:text-purple-400">+0.8% from last month</p>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div class="bg-slate-50 dark:bg-slate-800 rounded-lg p-6">
      <h3 class="font-medium text-slate-900 dark:text-white mb-4">Performance Metrics</h3>
      <div class="space-y-4">
        <div>
          <div class="flex justify-between mb-1">
            <span class="text-sm text-slate-600 dark:text-slate-400">Page Views</span>
            <span class="text-sm font-medium text-slate-900 dark:text-white">89%</span>
          </div>
          <div class="w-full bg-slate-200 dark:bg-slate-700 rounded-full h-2">
            <div class="bg-blue-600 h-2 rounded-full" style="width: 89%"></div>
          </div>
        </div>
        <div>
          <div class="flex justify-between mb-1">
            <span class="text-sm text-slate-600 dark:text-slate-400">User Engagement</span>
            <span class="text-sm font-medium text-slate-900 dark:text-white">76%</span>
          </div>
          <div class="w-full bg-slate-200 dark:bg-slate-700 rounded-full h-2">
            <div class="bg-green-600 h-2 rounded-full" style="width: 76%"></div>
          </div>
        </div>
        <div>
          <div class="flex justify-between mb-1">
            <span class="text-sm text-slate-600 dark:text-slate-400">Goal Completion</span>
            <span class="text-sm font-medium text-slate-900 dark:text-white">62%</span>
          </div>
          <div class="w-full bg-slate-200 dark:bg-slate-700 rounded-full h-2">
            <div class="bg-purple-600 h-2 rounded-full" style="width: 62%"></div>
          </div>
        </div>
      </div>
    </div>
    
    <div class="bg-slate-50 dark:bg-slate-800 rounded-lg p-6">
      <h3 class="font-medium text-slate-900 dark:text-white mb-4">Report Summary</h3>
      <div class="space-y-3">
        <div class="text-sm">
          <div class="font-medium text-slate-900 dark:text-white mb-1">Key Findings</div>
          <ul class="text-slate-600 dark:text-slate-400 space-y-1">
            <li>• Revenue growth exceeded expectations</li>
            <li>• User engagement improved significantly</li>
            <li>• Mobile traffic increased by 25%</li>
            <li>• Conversion funnel optimizations successful</li>
          </ul>
        </div>
        <div class="text-sm">
          <div class="font-medium text-slate-900 dark:text-white mb-1">Recommendations</div>
          <ul class="text-slate-600 dark:text-slate-400 space-y-1">
            <li>• Continue mobile optimization efforts</li>
            <li>• Expand successful campaign strategies</li>
            <li>• Focus on user retention programs</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>