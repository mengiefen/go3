<%= turbo_frame_tag frame_id do %>
  <div class="p-8">
    <div class="max-w-4xl mx-auto">
      <div class="bg-white dark:bg-slate-800 rounded-lg shadow-lg overflow-hidden">
        <div class="bg-gradient-to-r from-red-500 to-red-600 p-6 text-white">
          <h1 class="text-2xl font-bold">Admin: <%= content_name || content_id %></h1>
          <p class="text-red-100 mt-2">Administrator access and system management</p>
        </div>
        
        <div class="p-6 space-y-6">
          <div class="flex items-center space-x-6">
            <div class="w-24 h-24 bg-gradient-to-br from-red-400 to-red-600 rounded-full flex items-center justify-center text-2xl font-bold text-white">
              <svg class="w-12 h-12" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"/>
              </svg>
            </div>
            <div>
              <h2 class="text-xl font-semibold text-slate-900 dark:text-white"><%= content_name || "Administrator #{content_id}" %></h2>
              <p class="text-slate-600 dark:text-slate-400">admin@example.com</p>
              <span class="inline-block px-2 py-1 bg-red-100 dark:bg-red-900 text-red-800 dark:text-red-200 text-xs rounded-full mt-2">Super Admin</span>
            </div>
          </div>
          
          <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
            <div class="bg-slate-50 dark:bg-slate-700 p-4 rounded-lg">
              <h3 class="font-semibold text-slate-900 dark:text-white">Users</h3>
              <p class="text-2xl font-bold text-red-600 dark:text-red-400">1,247</p>
            </div>
            <div class="bg-slate-50 dark:bg-slate-700 p-4 rounded-lg">
              <h3 class="font-semibold text-slate-900 dark:text-white">Organizations</h3>
              <p class="text-2xl font-bold text-blue-600 dark:text-blue-400">89</p>
            </div>
            <div class="bg-slate-50 dark:bg-slate-700 p-4 rounded-lg">
              <h3 class="font-semibold text-slate-900 dark:text-white">Active Sessions</h3>
              <p class="text-2xl font-bold text-green-600 dark:text-green-400">324</p>
            </div>
            <div class="bg-slate-50 dark:bg-slate-700 p-4 rounded-lg">
              <h3 class="font-semibold text-slate-900 dark:text-white">System Health</h3>
              <p class="text-2xl font-bold text-purple-600 dark:text-purple-400">98%</p>
            </div>
          </div>
          
          <div class="border-t border-slate-200 dark:border-slate-600 pt-6">
            <h3 class="text-lg font-semibold text-slate-900 dark:text-white mb-4">Admin Actions</h3>
            <div class="space-y-3">
              <div class="flex items-center space-x-3">
                <div class="w-2 h-2 bg-red-400 rounded-full"></div>
                <span class="text-slate-600 dark:text-slate-300">Updated system configuration</span>
                <span class="text-sm text-slate-400">1 hour ago</span>
              </div>
              <div class="flex items-center space-x-3">
                <div class="w-2 h-2 bg-orange-400 rounded-full"></div>
                <span class="text-slate-600 dark:text-slate-300">Reviewed user permissions</span>
                <span class="text-sm text-slate-400">3 hours ago</span>
              </div>
              <div class="flex items-center space-x-3">
                <div class="w-2 h-2 bg-blue-400 rounded-full"></div>
                <span class="text-slate-600 dark:text-slate-300">Database maintenance completed</span>
                <span class="text-sm text-slate-400">1 day ago</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
<% end %>