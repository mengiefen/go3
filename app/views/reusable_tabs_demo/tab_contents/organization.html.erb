<%= turbo_frame_tag frame_id do %>
  <div class="p-8">
    <div class="max-w-4xl mx-auto">
      <div class="bg-white dark:bg-slate-800 rounded-lg shadow-lg overflow-hidden">
        <div class="bg-gradient-to-r from-blue-500 to-blue-600 p-6 text-white">
          <h1 class="text-2xl font-bold">Organization: <%= content_id %></h1>
          <p class="text-blue-100 mt-2">Manage your organization settings and members</p>
        </div>
        
        <div class="p-6 space-y-6">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div class="bg-slate-50 dark:bg-slate-700 p-4 rounded-lg">
              <h3 class="font-semibold text-slate-900 dark:text-white">Total Members</h3>
              <p class="text-2xl font-bold text-blue-600 dark:text-blue-400">142</p>
            </div>
            <div class="bg-slate-50 dark:bg-slate-700 p-4 rounded-lg">
              <h3 class="font-semibold text-slate-900 dark:text-white">Active Projects</h3>
              <p class="text-2xl font-bold text-green-600 dark:text-green-400">28</p>
            </div>
            <div class="bg-slate-50 dark:bg-slate-700 p-4 rounded-lg">
              <h3 class="font-semibold text-slate-900 dark:text-white">Departments</h3>
              <p class="text-2xl font-bold text-purple-600 dark:text-purple-400">8</p>
            </div>
          </div>
          
          <div class="border-t border-slate-200 dark:border-slate-600 pt-6">
            <h3 class="text-lg font-semibold text-slate-900 dark:text-white mb-4">Recent Activity</h3>
            <div class="space-y-3">
              <div class="flex items-center space-x-3">
                <div class="w-2 h-2 bg-green-400 rounded-full"></div>
                <span class="text-slate-600 dark:text-slate-300">New member John Doe joined Engineering</span>
                <span class="text-sm text-slate-400">2 hours ago</span>
              </div>
              <div class="flex items-center space-x-3">
                <div class="w-2 h-2 bg-blue-400 rounded-full"></div>
                <span class="text-slate-600 dark:text-slate-300">Project "Website Redesign" was updated</span>
                <span class="text-sm text-slate-400">5 hours ago</span>
              </div>
              <div class="flex items-center space-x-3">
                <div class="w-2 h-2 bg-purple-400 rounded-full"></div>
                <span class="text-slate-600 dark:text-slate-300">Department "Marketing" settings changed</span>
                <span class="text-sm text-slate-400">1 day ago</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
<% end %>