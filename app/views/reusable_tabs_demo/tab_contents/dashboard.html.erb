<%= turbo_frame_tag frame_id do %>
  <div class="p-8">
    <div class="max-w-6xl mx-auto">
      <div class="bg-white dark:bg-slate-800 rounded-lg shadow-lg overflow-hidden">
        <div class="bg-gradient-to-r from-indigo-500 to-indigo-600 p-6 text-white">
          <h1 class="text-2xl font-bold"><%= content_name || "Dashboard" %></h1>
          <p class="text-indigo-100 mt-2">Analytics and performance metrics</p>
        </div>
        
        <div class="p-6 space-y-6">
          <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
            <div class="bg-slate-50 dark:bg-slate-700 p-4 rounded-lg">
              <h3 class="font-semibold text-slate-900 dark:text-white">Total Users</h3>
              <p class="text-2xl font-bold text-indigo-600 dark:text-indigo-400">1,248</p>
              <p class="text-sm text-green-600 dark:text-green-400">↑ 12% from last month</p>
            </div>
            <div class="bg-slate-50 dark:bg-slate-700 p-4 rounded-lg">
              <h3 class="font-semibold text-slate-900 dark:text-white">Active Sessions</h3>
              <p class="text-2xl font-bold text-blue-600 dark:text-blue-400">342</p>
              <p class="text-sm text-slate-600 dark:text-slate-400">Live now</p>
            </div>
            <div class="bg-slate-50 dark:bg-slate-700 p-4 rounded-lg">
              <h3 class="font-semibold text-slate-900 dark:text-white">Revenue</h3>
              <p class="text-2xl font-bold text-green-600 dark:text-green-400">$48.2k</p>
              <p class="text-sm text-green-600 dark:text-green-400">↑ 8% from last month</p>
            </div>
            <div class="bg-slate-50 dark:bg-slate-700 p-4 rounded-lg">
              <h3 class="font-semibold text-slate-900 dark:text-white">Conversion</h3>
              <p class="text-2xl font-bold text-purple-600 dark:text-purple-400">3.2%</p>
              <p class="text-sm text-red-600 dark:text-red-400">↓ 0.5% from last month</p>
            </div>
          </div>
          
          <div class="space-y-4">
            <h3 class="text-lg font-semibold text-slate-900 dark:text-white">Recent Activity</h3>
            
            <div class="bg-white dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-lg p-6">
              <div class="space-y-4">
                <div class="flex items-center justify-between">
                  <span class="text-slate-700 dark:text-slate-300">Page Views</span>
                  <span class="font-semibold text-slate-900 dark:text-white">24,589</span>
                </div>
                <div class="w-full bg-slate-200 dark:bg-slate-600 rounded-full h-2">
                  <div class="bg-blue-600 h-2 rounded-full" style="width: 75%"></div>
                </div>
              </div>
            </div>
            
            <div class="bg-white dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-lg p-6">
              <div class="space-y-4">
                <div class="flex items-center justify-between">
                  <span class="text-slate-700 dark:text-slate-300">Goal Completion</span>
                  <span class="font-semibold text-slate-900 dark:text-white">68%</span>
                </div>
                <div class="w-full bg-slate-200 dark:bg-slate-600 rounded-full h-2">
                  <div class="bg-green-600 h-2 rounded-full" style="width: 68%"></div>
                </div>
              </div>
            </div>
          </div>
          
          <div class="border-t border-slate-200 dark:border-slate-600 pt-6">
            <h3 class="text-lg font-semibold text-slate-900 dark:text-white mb-4">Top Performers</h3>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
              <div class="text-center">
                <div class="w-16 h-16 mx-auto bg-gradient-to-br from-yellow-400 to-yellow-600 rounded-full flex items-center justify-center text-white font-bold text-xl mb-2">
                  JD
                </div>
                <p class="font-medium text-slate-900 dark:text-white">John Doe</p>
                <p class="text-sm text-slate-600 dark:text-slate-400">Sales Lead</p>
              </div>
              <div class="text-center">
                <div class="w-16 h-16 mx-auto bg-gradient-to-br from-pink-400 to-pink-600 rounded-full flex items-center justify-center text-white font-bold text-xl mb-2">
                  JS
                </div>
                <p class="font-medium text-slate-900 dark:text-white">Jane Smith</p>
                <p class="text-sm text-slate-600 dark:text-slate-400">Marketing Manager</p>
              </div>
              <div class="text-center">
                <div class="w-16 h-16 mx-auto bg-gradient-to-br from-purple-400 to-purple-600 rounded-full flex items-center justify-center text-white font-bold text-xl mb-2">
                  MW
                </div>
                <p class="font-medium text-slate-900 dark:text-white">Mike Wilson</p>
                <p class="text-sm text-slate-600 dark:text-slate-400">Support Hero</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
<% end %>