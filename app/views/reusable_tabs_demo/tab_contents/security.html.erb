<%= turbo_frame_tag frame_id do %>
  <div class="p-8">
    <div class="max-w-4xl mx-auto">
      <div class="bg-white dark:bg-slate-800 rounded-lg shadow-lg overflow-hidden">
        <div class="bg-gradient-to-r from-red-500 to-red-600 p-6 text-white">
          <h1 class="text-2xl font-bold">Security: <%= content_name || content_id %></h1>
          <p class="text-red-100 mt-2">Security settings and access control</p>
        </div>
        
        <div class="p-6 space-y-6">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div class="bg-slate-50 dark:bg-slate-700 p-4 rounded-lg">
              <h3 class="font-semibold text-slate-900 dark:text-white">Login Attempts</h3>
              <p class="text-2xl font-bold text-green-600 dark:text-green-400">0</p>
              <p class="text-xs text-slate-500 dark:text-slate-400">Failed in last 24h</p>
            </div>
            <div class="bg-slate-50 dark:bg-slate-700 p-4 rounded-lg">
              <h3 class="font-semibold text-slate-900 dark:text-white">2FA Status</h3>
              <p class="text-2xl font-bold text-green-600 dark:text-green-400">✓</p>
              <p class="text-xs text-slate-500 dark:text-slate-400">Enabled</p>
            </div>
            <div class="bg-slate-50 dark:bg-slate-700 p-4 rounded-lg">
              <h3 class="font-semibold text-slate-900 dark:text-white">Active Sessions</h3>
              <p class="text-2xl font-bold text-blue-600 dark:text-blue-400">3</p>
              <p class="text-xs text-slate-500 dark:text-slate-400">Devices logged in</p>
            </div>
          </div>
          
          <div class="space-y-4">
            <h3 class="text-lg font-semibold text-slate-900 dark:text-white">Security Features</h3>
            
            <div class="bg-green-50 dark:bg-green-900/20 border-l-4 border-green-400 p-4">
              <div class="flex items-center">
                <svg class="h-5 w-5 text-green-400 mr-3" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
                <span class="text-green-800 dark:text-green-200 font-medium">Two-Factor Authentication Enabled</span>
              </div>
            </div>
            
            <div class="bg-blue-50 dark:bg-blue-900/20 border-l-4 border-blue-400 p-4">
              <div class="flex items-center">
                <svg class="h-5 w-5 text-blue-400 mr-3" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
                <span class="text-blue-800 dark:text-blue-200 font-medium">Strong Password Policy Active</span>
              </div>
            </div>
            
            <div class="bg-yellow-50 dark:bg-yellow-900/20 border-l-4 border-yellow-400 p-4">
              <div class="flex items-center">
                <svg class="h-5 w-5 text-yellow-400 mr-3" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
                </svg>
                <span class="text-yellow-800 dark:text-yellow-200 font-medium">Password expires in 45 days</span>
              </div>
            </div>
          </div>
          
          <div class="border-t border-slate-200 dark:border-slate-600 pt-6">
            <h3 class="text-lg font-semibold text-slate-900 dark:text-white mb-4">Recent Security Events</h3>
            <div class="space-y-3">
              <div class="flex items-center space-x-3">
                <div class="w-2 h-2 bg-green-400 rounded-full"></div>
                <span class="text-slate-600 dark:text-slate-300">Successful login from Chrome on macOS</span>
                <span class="text-sm text-slate-400">2 hours ago</span>
              </div>
              <div class="flex items-center space-x-3">
                <div class="w-2 h-2 bg-blue-400 rounded-full"></div>
                <span class="text-slate-600 dark:text-slate-300">Password changed successfully</span>
                <span class="text-sm text-slate-400">1 week ago</span>
              </div>
              <div class="flex items-center space-x-3">
                <div class="w-2 h-2 bg-purple-400 rounded-full"></div>
                <span class="text-slate-600 dark:text-slate-300">2FA backup codes generated</span>
                <span class="text-sm text-slate-400">2 weeks ago</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
<% end %>