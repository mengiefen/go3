<div class="p-6 bg-white dark:bg-slate-900">
  <div class="flex items-center space-x-3 mb-6">
    <div class="w-8 h-8 bg-red-100 dark:bg-red-900 rounded-lg flex items-center justify-center">
      <svg class="w-5 h-5 text-red-600 dark:text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
      </svg>
    </div>
    <div>
      <h1 class="text-xl font-semibold text-slate-900 dark:text-white">Security: <%= params[:content_name] || content_id %></h1>
      <p class="text-sm text-slate-500 dark:text-slate-400">Security settings and access control</p>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div class="space-y-6">
      <div class="bg-slate-50 dark:bg-slate-800 rounded-lg p-6">
        <h3 class="font-medium text-slate-900 dark:text-white mb-4">Two-Factor Authentication</h3>
        <div class="space-y-4">
          <div class="flex items-center justify-between p-4 bg-white dark:bg-slate-700 rounded-lg border border-slate-200 dark:border-slate-600">
            <div class="flex items-center space-x-3">
              <div class="w-8 h-8 bg-green-100 dark:bg-green-900 rounded-lg flex items-center justify-center">
                <svg class="w-4 h-4 text-green-600 dark:text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
              <div>
                <div class="text-sm font-medium text-slate-900 dark:text-white">Authenticator App</div>
                <div class="text-xs text-slate-500 dark:text-slate-400">Enabled</div>
              </div>
            </div>
            <button class="text-xs text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300">Configure</button>
          </div>
          <div class="flex items-center justify-between p-4 bg-white dark:bg-slate-700 rounded-lg border border-slate-200 dark:border-slate-600">
            <div class="flex items-center space-x-3">
              <div class="w-8 h-8 bg-slate-100 dark:bg-slate-600 rounded-lg flex items-center justify-center">
                <svg class="w-4 h-4 text-slate-500 dark:text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                </svg>
              </div>
              <div>
                <div class="text-sm font-medium text-slate-900 dark:text-white">SMS Backup</div>
                <div class="text-xs text-slate-500 dark:text-slate-400">Not configured</div>
              </div>
            </div>
            <button class="text-xs text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300">Setup</button>
          </div>
        </div>
      </div>

      <div class="bg-slate-50 dark:bg-slate-800 rounded-lg p-6">
        <h3 class="font-medium text-slate-900 dark:text-white mb-4">Password Security</h3>
        <div class="space-y-4">
          <div>
            <div class="text-sm font-medium text-slate-900 dark:text-white mb-2">Password Strength</div>
            <div class="flex items-center space-x-2">
              <div class="flex-1 bg-slate-200 dark:bg-slate-700 rounded-full h-2">
                <div class="bg-green-600 h-2 rounded-full" style="width: 85%"></div>
              </div>
              <span class="text-xs text-green-600 dark:text-green-400">Strong</span>
            </div>
          </div>
          <div>
            <div class="text-sm font-medium text-slate-900 dark:text-white mb-1">Last Changed</div>
            <div class="text-xs text-slate-500 dark:text-slate-400">3 months ago</div>
          </div>
          <button class="w-full px-4 py-2 bg-blue-600 text-white text-sm rounded-lg hover:bg-blue-700 transition-colors">
            Change Password
          </button>
        </div>
      </div>
    </div>

    <div class="space-y-6">
      <div class="bg-slate-50 dark:bg-slate-800 rounded-lg p-6">
        <h3 class="font-medium text-slate-900 dark:text-white mb-4">Recent Security Activity</h3>
        <div class="space-y-3">
          <div class="flex items-start space-x-3 p-3 bg-white dark:bg-slate-700 rounded-lg">
            <div class="w-2 h-2 bg-green-500 rounded-full mt-2"></div>
            <div class="flex-1 min-w-0">
              <div class="text-sm font-medium text-slate-900 dark:text-white">Successful login</div>
              <div class="text-xs text-slate-500 dark:text-slate-400">MacBook Pro • Chrome • 192.168.1.1</div>
              <div class="text-xs text-slate-400 dark:text-slate-500">2 hours ago</div>
            </div>
          </div>
          <div class="flex items-start space-x-3 p-3 bg-white dark:bg-slate-700 rounded-lg">
            <div class="w-2 h-2 bg-yellow-500 rounded-full mt-2"></div>
            <div class="flex-1 min-w-0">
              <div class="text-sm font-medium text-slate-900 dark:text-white">Password changed</div>
              <div class="text-xs text-slate-500 dark:text-slate-400">Security settings updated</div>
              <div class="text-xs text-slate-400 dark:text-slate-500">3 months ago</div>
            </div>
          </div>
          <div class="flex items-start space-x-3 p-3 bg-white dark:bg-slate-700 rounded-lg">
            <div class="w-2 h-2 bg-blue-500 rounded-full mt-2"></div>
            <div class="flex-1 min-w-0">
              <div class="text-sm font-medium text-slate-900 dark:text-white">2FA enabled</div>
              <div class="text-xs text-slate-500 dark:text-slate-400">Authenticator app configured</div>
              <div class="text-xs text-slate-400 dark:text-slate-500">6 months ago</div>
            </div>
          </div>
        </div>
      </div>

      <div class="bg-slate-50 dark:bg-slate-800 rounded-lg p-6">
        <h3 class="font-medium text-slate-900 dark:text-white mb-4">Security Recommendations</h3>
        <div class="space-y-3">
          <div class="flex items-center space-x-3 p-3 bg-yellow-50 dark:bg-yellow-900/20 border border-yellow-200 dark:border-yellow-800 rounded-lg">
            <svg class="w-5 h-5 text-yellow-600 dark:text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
            </svg>
            <div class="flex-1 text-sm text-yellow-800 dark:text-yellow-200">
              Consider enabling SMS backup for 2FA
            </div>
          </div>
          <div class="flex items-center space-x-3 p-3 bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 rounded-lg">
            <svg class="w-5 h-5 text-green-600 dark:text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <div class="flex-1 text-sm text-green-800 dark:text-green-200">
              Your account security is excellent
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>