<div class="p-6 bg-white dark:bg-slate-900">
  <div class="flex items-center space-x-3 mb-6">
    <div class="w-8 h-8 bg-red-100 dark:bg-red-900 rounded-lg flex items-center justify-center">
      <svg class="w-5 h-5 text-red-600 dark:text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
      </svg>
    </div>
    <div>
      <h1 class="text-xl font-semibold text-slate-900 dark:text-white">Admin: <%= params[:content_name] || content_id %></h1>
      <p class="text-sm text-slate-500 dark:text-slate-400">Administrative user profile and permissions</p>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div class="space-y-4">
      <div class="bg-slate-50 dark:bg-slate-800 rounded-lg p-4">
        <h3 class="font-medium text-slate-900 dark:text-white mb-3">Admin Details</h3>
        <div class="space-y-2">
          <div class="flex justify-between">
            <span class="text-sm text-slate-500 dark:text-slate-400">Role</span>
            <span class="text-sm font-medium text-slate-900 dark:text-white">System Administrator</span>
          </div>
          <div class="flex justify-between">
            <span class="text-sm text-slate-500 dark:text-slate-400">Last Login</span>
            <span class="text-sm font-medium text-slate-900 dark:text-white">2 hours ago</span>
          </div>
          <div class="flex justify-between">
            <span class="text-sm text-slate-500 dark:text-slate-400">Status</span>
            <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200">
              Active
            </span>
          </div>
        </div>
      </div>
      
      <div class="bg-slate-50 dark:bg-slate-800 rounded-lg p-4">
        <h3 class="font-medium text-slate-900 dark:text-white mb-3">Permissions</h3>
        <div class="space-y-2">
          <div class="flex items-center space-x-2">
            <div class="w-2 h-2 bg-green-500 rounded-full"></div>
            <span class="text-sm text-slate-700 dark:text-slate-300">User Management</span>
          </div>
          <div class="flex items-center space-x-2">
            <div class="w-2 h-2 bg-green-500 rounded-full"></div>
            <span class="text-sm text-slate-700 dark:text-slate-300">System Configuration</span>
          </div>
          <div class="flex items-center space-x-2">
            <div class="w-2 h-2 bg-green-500 rounded-full"></div>
            <span class="text-sm text-slate-700 dark:text-slate-300">Audit Log Access</span>
          </div>
          <div class="flex items-center space-x-2">
            <div class="w-2 h-2 bg-yellow-500 rounded-full"></div>
            <span class="text-sm text-slate-700 dark:text-slate-300">Backup Management</span>
          </div>
        </div>
      </div>
    </div>
    
    <div class="space-y-4">
      <div class="bg-slate-50 dark:bg-slate-800 rounded-lg p-4">
        <h3 class="font-medium text-slate-900 dark:text-white mb-3">Recent Actions</h3>
        <div class="space-y-3">
          <div class="text-sm">
            <div class="font-medium text-slate-900 dark:text-white">User account created</div>
            <div class="text-slate-500 dark:text-slate-400">10 minutes ago</div>
          </div>
          <div class="text-sm">
            <div class="font-medium text-slate-900 dark:text-white">System backup initiated</div>
            <div class="text-slate-500 dark:text-slate-400">1 hour ago</div>
          </div>
          <div class="text-sm">
            <div class="font-medium text-slate-900 dark:text-white">Security settings updated</div>
            <div class="text-slate-500 dark:text-slate-400">3 hours ago</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>