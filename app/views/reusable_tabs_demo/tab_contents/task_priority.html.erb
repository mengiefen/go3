<%= turbo_frame_tag frame_id do %>
  <div class="p-8">
    <div class="max-w-4xl mx-auto">
      <div class="bg-white dark:bg-slate-800 rounded-lg shadow-lg overflow-hidden">
        <div class="bg-gradient-to-r from-orange-500 to-orange-600 p-6 text-white">
          <h1 class="text-2xl font-bold">Priority: <%= content_name || content_id %></h1>
          <p class="text-orange-100 mt-2">Tasks filtered by priority level</p>
        </div>
        
        <div class="p-6 space-y-6">
          <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
            <div class="bg-slate-50 dark:bg-slate-700 p-4 rounded-lg">
              <h3 class="font-semibold text-slate-900 dark:text-white">Total Tasks</h3>
              <p class="text-2xl font-bold text-orange-600 dark:text-orange-400">
                <%= content_id == 'urgent' ? '3' : content_id == 'high' ? '8' : content_id == 'medium' ? '20' : '14' %>
              </p>
            </div>
            <div class="bg-slate-50 dark:bg-slate-700 p-4 rounded-lg">
              <h3 class="font-semibold text-slate-900 dark:text-white">Assigned</h3>
              <p class="text-2xl font-bold text-blue-600 dark:text-blue-400">
                <%= content_id == 'urgent' ? '3' : content_id == 'high' ? '6' : content_id == 'medium' ? '15' : '8' %>
              </p>
            </div>
            <div class="bg-slate-50 dark:bg-slate-700 p-4 rounded-lg">
              <h3 class="font-semibold text-slate-900 dark:text-white">In Progress</h3>
              <p class="text-2xl font-bold text-yellow-600 dark:text-yellow-400">
                <%= content_id == 'urgent' ? '2' : content_id == 'high' ? '4' : content_id == 'medium' ? '8' : '3' %>
              </p>
            </div>
            <div class="bg-slate-50 dark:bg-slate-700 p-4 rounded-lg">
              <h3 class="font-semibold text-slate-900 dark:text-white">Completed</h3>
              <p class="text-2xl font-bold text-green-600 dark:text-green-400">
                <%= content_id == 'urgent' ? '1' : content_id == 'high' ? '2' : content_id == 'medium' ? '12' : '11' %>
              </p>
            </div>
          </div>
          
          <div class="space-y-4">
            <h3 class="text-lg font-semibold text-slate-900 dark:text-white">
              <%= content_id.capitalize %> Priority Tasks
            </h3>
            
            <div class="space-y-3">
              <% if content_id == 'urgent' %>
                <div class="bg-white dark:bg-slate-700 border-2 border-red-300 dark:border-red-700 rounded-lg p-4">
                  <div class="flex items-center justify-between">
                    <div class="flex items-center space-x-3">
                      <div class="w-3 h-3 bg-red-500 rounded-full animate-pulse"></div>
                      <div>
                        <h4 class="font-medium text-slate-900 dark:text-white">Critical security update</h4>
                        <p class="text-sm text-slate-600 dark:text-slate-400">Due: Today 5:00 PM</p>
                      </div>
                    </div>
                    <span class="px-2 py-1 bg-red-100 dark:bg-red-900 text-red-800 dark:text-red-200 text-xs rounded-full font-semibold">URGENT</span>
                  </div>
                </div>
                
                <div class="bg-white dark:bg-slate-700 border-2 border-red-300 dark:border-red-700 rounded-lg p-4">
                  <div class="flex items-center justify-between">
                    <div class="flex items-center space-x-3">
                      <div class="w-3 h-3 bg-red-500 rounded-full animate-pulse"></div>
                      <div>
                        <h4 class="font-medium text-slate-900 dark:text-white">Production server down</h4>
                        <p class="text-sm text-slate-600 dark:text-slate-400">Started: 30 minutes ago</p>
                      </div>
                    </div>
                    <span class="px-2 py-1 bg-red-100 dark:bg-red-900 text-red-800 dark:text-red-200 text-xs rounded-full font-semibold">URGENT</span>
                  </div>
                </div>
              <% elsif content_id == 'high' %>
                <div class="bg-white dark:bg-slate-700 border border-orange-300 dark:border-orange-700 rounded-lg p-4">
                  <div class="flex items-center justify-between">
                    <div class="flex items-center space-x-3">
                      <div class="w-3 h-3 bg-orange-500 rounded-full"></div>
                      <div>
                        <h4 class="font-medium text-slate-900 dark:text-white">Client presentation preparation</h4>
                        <p class="text-sm text-slate-600 dark:text-slate-400">Due: Tomorrow 10:00 AM</p>
                      </div>
                    </div>
                    <span class="px-2 py-1 bg-orange-100 dark:bg-orange-900 text-orange-800 dark:text-orange-200 text-xs rounded-full">HIGH</span>
                  </div>
                </div>
                
                <div class="bg-white dark:bg-slate-700 border border-orange-300 dark:border-orange-700 rounded-lg p-4">
                  <div class="flex items-center justify-between">
                    <div class="flex items-center space-x-3">
                      <div class="w-3 h-3 bg-orange-500 rounded-full"></div>
                      <div>
                        <h4 class="font-medium text-slate-900 dark:text-white">Database optimization</h4>
                        <p class="text-sm text-slate-600 dark:text-slate-400">Due: This week</p>
                      </div>
                    </div>
                    <span class="px-2 py-1 bg-orange-100 dark:bg-orange-900 text-orange-800 dark:text-orange-200 text-xs rounded-full">HIGH</span>
                  </div>
                </div>
              <% elsif content_id == 'medium' %>
                <div class="bg-white dark:bg-slate-700 border border-blue-300 dark:border-blue-700 rounded-lg p-4">
                  <div class="flex items-center justify-between">
                    <div class="flex items-center space-x-3">
                      <div class="w-3 h-3 bg-blue-500 rounded-full"></div>
                      <div>
                        <h4 class="font-medium text-slate-900 dark:text-white">Update documentation</h4>
                        <p class="text-sm text-slate-600 dark:text-slate-400">Due: Next week</p>
                      </div>
                    </div>
                    <span class="px-2 py-1 bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200 text-xs rounded-full">MEDIUM</span>
                  </div>
                </div>
                
                <div class="bg-white dark:bg-slate-700 border border-blue-300 dark:border-blue-700 rounded-lg p-4">
                  <div class="flex items-center justify-between">
                    <div class="flex items-center space-x-3">
                      <div class="w-3 h-3 bg-blue-500 rounded-full"></div>
                      <div>
                        <h4 class="font-medium text-slate-900 dark:text-white">Code review for feature branch</h4>
                        <p class="text-sm text-slate-600 dark:text-slate-400">Due: 3 days</p>
                      </div>
                    </div>
                    <span class="px-2 py-1 bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200 text-xs rounded-full">MEDIUM</span>
                  </div>
                </div>
              <% else %>
                <div class="bg-white dark:bg-slate-700 border border-green-300 dark:border-green-700 rounded-lg p-4">
                  <div class="flex items-center justify-between">
                    <div class="flex items-center space-x-3">
                      <div class="w-3 h-3 bg-green-500 rounded-full"></div>
                      <div>
                        <h4 class="font-medium text-slate-900 dark:text-white">Clean up old log files</h4>
                        <p class="text-sm text-slate-600 dark:text-slate-400">Due: End of month</p>
                      </div>
                    </div>
                    <span class="px-2 py-1 bg-green-100 dark:bg-green-900 text-green-800 dark:text-green-200 text-xs rounded-full">LOW</span>
                  </div>
                </div>
                
                <div class="bg-white dark:bg-slate-700 border border-green-300 dark:border-green-700 rounded-lg p-4">
                  <div class="flex items-center justify-between">
                    <div class="flex items-center space-x-3">
                      <div class="w-3 h-3 bg-green-500 rounded-full"></div>
                      <div>
                        <h4 class="font-medium text-slate-900 dark:text-white">Update team calendar</h4>
                        <p class="text-sm text-slate-600 dark:text-slate-400">Due: Whenever</p>
                      </div>
                    </div>
                    <span class="px-2 py-1 bg-green-100 dark:bg-green-900 text-green-800 dark:text-green-200 text-xs rounded-full">LOW</span>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
          
          <div class="border-t border-slate-200 dark:border-slate-600 pt-6">
            <div class="flex items-center justify-between">
              <h3 class="text-lg font-semibold text-slate-900 dark:text-white">Priority Distribution</h3>
              <button class="text-sm text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300">
                View all tasks →
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
<% end %>