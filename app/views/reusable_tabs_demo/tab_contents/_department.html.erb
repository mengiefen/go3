<div class="p-6 bg-white dark:bg-slate-900">
  <div class="flex items-center space-x-3 mb-6">
    <div class="w-8 h-8 bg-blue-100 dark:bg-blue-900 rounded-lg flex items-center justify-center">
      <svg class="w-5 h-5 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
      </svg>
    </div>
    <div>
      <h1 class="text-xl font-semibold text-slate-900 dark:text-white">Department: <%= params[:content_name] || content_id %></h1>
      <p class="text-sm text-slate-500 dark:text-slate-400">Department management and overview</p>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <div class="bg-slate-50 dark:bg-slate-800 rounded-lg p-4">
      <h3 class="font-medium text-slate-900 dark:text-white mb-2">Team Members</h3>
      <div class="text-2xl font-bold text-blue-600 dark:text-blue-400">24</div>
      <p class="text-xs text-slate-500 dark:text-slate-400">Active employees</p>
    </div>
    
    <div class="bg-slate-50 dark:bg-slate-800 rounded-lg p-4">
      <h3 class="font-medium text-slate-900 dark:text-white mb-2">Projects</h3>
      <div class="text-2xl font-bold text-green-600 dark:text-green-400">8</div>
      <p class="text-xs text-slate-500 dark:text-slate-400">Active projects</p>
    </div>
    
    <div class="bg-slate-50 dark:bg-slate-800 rounded-lg p-4">
      <h3 class="font-medium text-slate-900 dark:text-white mb-2">Budget</h3>
      <div class="text-2xl font-bold text-purple-600 dark:text-purple-400">$125K</div>
      <p class="text-xs text-slate-500 dark:text-slate-400">Monthly allocation</p>
    </div>
  </div>

  <div class="mt-8">
    <h2 class="text-lg font-medium text-slate-900 dark:text-white mb-4">Recent Activity</h2>
    <div class="space-y-3">
      <div class="flex items-center space-x-3 p-3 bg-slate-50 dark:bg-slate-800 rounded-lg">
        <div class="w-2 h-2 bg-blue-400 rounded-full"></div>
        <span class="text-sm text-slate-700 dark:text-slate-300">New team member added</span>
        <span class="text-xs text-slate-500 dark:text-slate-400 ml-auto">2 hours ago</span>
      </div>
      <div class="flex items-center space-x-3 p-3 bg-slate-50 dark:bg-slate-800 rounded-lg">
        <div class="w-2 h-2 bg-green-400 rounded-full"></div>
        <span class="text-sm text-slate-700 dark:text-slate-300">Project milestone completed</span>
        <span class="text-xs text-slate-500 dark:text-slate-400 ml-auto">1 day ago</span>
      </div>
      <div class="flex items-center space-x-3 p-3 bg-slate-50 dark:bg-slate-800 rounded-lg">
        <div class="w-2 h-2 bg-orange-400 rounded-full"></div>
        <span class="text-sm text-slate-700 dark:text-slate-300">Budget review scheduled</span>
        <span class="text-xs text-slate-500 dark:text-slate-400 ml-auto">3 days ago</span>
      </div>
    </div>
  </div>
</div>