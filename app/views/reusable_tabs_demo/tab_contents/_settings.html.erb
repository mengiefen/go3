<div class="p-6 bg-white dark:bg-slate-900">
  <div class="flex items-center space-x-3 mb-6">
    <div class="w-8 h-8 bg-slate-100 dark:bg-slate-800 rounded-lg flex items-center justify-center">
      <svg class="w-5 h-5 text-slate-600 dark:text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
      </svg>
    </div>
    <div>
      <h1 class="text-xl font-semibold text-slate-900 dark:text-white">Settings: <%= params[:content_name] || content_id %></h1>
      <p class="text-sm text-slate-500 dark:text-slate-400">System configuration and preferences</p>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div class="space-y-6">
      <div class="bg-slate-50 dark:bg-slate-800 rounded-lg p-6">
        <h3 class="font-medium text-slate-900 dark:text-white mb-4">General Settings</h3>
        <div class="space-y-4">
          <div class="flex items-center justify-between">
            <div>
              <div class="text-sm font-medium text-slate-900 dark:text-white">Email Notifications</div>
              <div class="text-xs text-slate-500 dark:text-slate-400">Receive email updates about important events</div>
            </div>
            <button class="relative inline-flex h-6 w-11 items-center rounded-full bg-blue-600 transition-colors">
              <span class="sr-only">Enable notifications</span>
              <span class="inline-block h-4 w-4 transform rounded-full bg-white transition translate-x-6"></span>
            </button>
          </div>
          <div class="flex items-center justify-between">
            <div>
              <div class="text-sm font-medium text-slate-900 dark:text-white">Dark Mode</div>
              <div class="text-xs text-slate-500 dark:text-slate-400">Use dark theme for the interface</div>
            </div>
            <button class="relative inline-flex h-6 w-11 items-center rounded-full bg-slate-300 dark:bg-slate-600 transition-colors">
              <span class="sr-only">Enable dark mode</span>
              <span class="inline-block h-4 w-4 transform rounded-full bg-white transition translate-x-1"></span>
            </button>
          </div>
          <div class="flex items-center justify-between">
            <div>
              <div class="text-sm font-medium text-slate-900 dark:text-white">Auto-save</div>
              <div class="text-xs text-slate-500 dark:text-slate-400">Automatically save changes as you work</div>
            </div>
            <button class="relative inline-flex h-6 w-11 items-center rounded-full bg-blue-600 transition-colors">
              <span class="sr-only">Enable auto-save</span>
              <span class="inline-block h-4 w-4 transform rounded-full bg-white transition translate-x-6"></span>
            </button>
          </div>
        </div>
      </div>

      <div class="bg-slate-50 dark:bg-slate-800 rounded-lg p-6">
        <h3 class="font-medium text-slate-900 dark:text-white mb-4">Privacy Settings</h3>
        <div class="space-y-4">
          <div>
            <label class="text-sm font-medium text-slate-900 dark:text-white">Profile Visibility</label>
            <select class="mt-1 block w-full rounded-md border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 px-3 py-2 text-sm">
              <option>Public</option>
              <option>Private</option>
              <option>Friends Only</option>
            </select>
          </div>
          <div>
            <label class="text-sm font-medium text-slate-900 dark:text-white">Data Sharing</label>
            <select class="mt-1 block w-full rounded-md border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 px-3 py-2 text-sm">
              <option>Minimal</option>
              <option>Standard</option>
              <option>Full Analytics</option>
            </select>
          </div>
        </div>
      </div>
    </div>

    <div class="space-y-6">
      <div class="bg-slate-50 dark:bg-slate-800 rounded-lg p-6">
        <h3 class="font-medium text-slate-900 dark:text-white mb-4">Account Settings</h3>
        <div class="space-y-4">
          <div>
            <label class="text-sm font-medium text-slate-900 dark:text-white">Language</label>
            <select class="mt-1 block w-full rounded-md border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 px-3 py-2 text-sm">
              <option>English (US)</option>
              <option>English (UK)</option>
              <option>Spanish</option>
              <option>French</option>
            </select>
          </div>
          <div>
            <label class="text-sm font-medium text-slate-900 dark:text-white">Timezone</label>
            <select class="mt-1 block w-full rounded-md border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 px-3 py-2 text-sm">
              <option>UTC-8 (Pacific)</option>
              <option>UTC-5 (Eastern)</option>
              <option>UTC+0 (GMT)</option>
              <option>UTC+1 (Central European)</option>
            </select>
          </div>
          <div>
            <label class="text-sm font-medium text-slate-900 dark:text-white">Date Format</label>
            <select class="mt-1 block w-full rounded-md border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 px-3 py-2 text-sm">
              <option>MM/DD/YYYY</option>
              <option>DD/MM/YYYY</option>
              <option>YYYY-MM-DD</option>
            </select>
          </div>
        </div>
      </div>

      <div class="bg-slate-50 dark:bg-slate-800 rounded-lg p-6">
        <h3 class="font-medium text-slate-900 dark:text-white mb-4">Advanced</h3>
        <div class="space-y-3">
          <button class="w-full text-left px-4 py-2 bg-white dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-lg hover:bg-slate-50 dark:hover:bg-slate-600 transition-colors">
            <div class="text-sm font-medium text-slate-900 dark:text-white">Export Data</div>
            <div class="text-xs text-slate-500 dark:text-slate-400">Download a copy of your data</div>
          </button>
          <button class="w-full text-left px-4 py-2 bg-white dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-lg hover:bg-slate-50 dark:hover:bg-slate-600 transition-colors">
            <div class="text-sm font-medium text-slate-900 dark:text-white">Reset Settings</div>
            <div class="text-xs text-slate-500 dark:text-slate-400">Restore default configuration</div>
          </button>
          <button class="w-full text-left px-4 py-2 bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-lg hover:bg-red-100 dark:hover:bg-red-900/30 transition-colors">
            <div class="text-sm font-medium text-red-900 dark:text-red-200">Delete Account</div>
            <div class="text-xs text-red-600 dark:text-red-400">Permanently remove your account</div>
          </button>
        </div>
      </div>
    </div>
  </div>
</div>