<%= turbo_frame_tag frame_id do %>
  <div class="p-8">
    <div class="max-w-4xl mx-auto">
      <div class="bg-white dark:bg-slate-800 rounded-lg shadow-lg overflow-hidden">
        <div class="bg-gradient-to-r from-green-500 to-green-600 p-6 text-white">
          <h1 class="text-2xl font-bold">User: <%= content_name || content_id %></h1>
          <p class="text-green-100 mt-2">User profile and account management</p>
        </div>
        
        <div class="p-6 space-y-6">
          <div class="flex items-center space-x-6">
            <div class="w-24 h-24 bg-gradient-to-br from-green-400 to-green-600 rounded-full flex items-center justify-center text-2xl font-bold text-white">
              <%= (content_name || content_id).first(2).upcase %>
            </div>
            <div>
              <h2 class="text-xl font-semibold text-slate-900 dark:text-white"><%= content_name || "User #{content_id}" %></h2>
              <p class="text-slate-600 dark:text-slate-400">user@example.com</p>
              <span class="inline-block px-2 py-1 bg-green-100 dark:bg-green-900 text-green-800 dark:text-green-200 text-xs rounded-full mt-2">Active</span>
            </div>
          </div>
          
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div class="bg-slate-50 dark:bg-slate-700 p-4 rounded-lg">
              <h3 class="font-semibold text-slate-900 dark:text-white">Login Count</h3>
              <p class="text-2xl font-bold text-green-600 dark:text-green-400">247</p>
            </div>
            <div class="bg-slate-50 dark:bg-slate-700 p-4 rounded-lg">
              <h3 class="font-semibold text-slate-900 dark:text-white">Projects</h3>
              <p class="text-2xl font-bold text-blue-600 dark:text-blue-400">12</p>
            </div>
            <div class="bg-slate-50 dark:bg-slate-700 p-4 rounded-lg">
              <h3 class="font-semibold text-slate-900 dark:text-white">Last Active</h3>
              <p class="text-2xl font-bold text-purple-600 dark:text-purple-400">Today</p>
            </div>
          </div>
          
          <div class="border-t border-slate-200 dark:border-slate-600 pt-6">
            <h3 class="text-lg font-semibold text-slate-900 dark:text-white mb-4">Recent Activity</h3>
            <div class="space-y-3">
              <div class="flex items-center space-x-3">
                <div class="w-2 h-2 bg-green-400 rounded-full"></div>
                <span class="text-slate-600 dark:text-slate-300">Logged in from Chrome on macOS</span>
                <span class="text-sm text-slate-400">2 hours ago</span>
              </div>
              <div class="flex items-center space-x-3">
                <div class="w-2 h-2 bg-blue-400 rounded-full"></div>
                <span class="text-slate-600 dark:text-slate-300">Updated profile information</span>
                <span class="text-sm text-slate-400">1 day ago</span>
              </div>
              <div class="flex items-center space-x-3">
                <div class="w-2 h-2 bg-purple-400 rounded-full"></div>
                <span class="text-slate-600 dark:text-slate-300">Completed project milestone</span>
                <span class="text-sm text-slate-400">3 days ago</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
<% end %>