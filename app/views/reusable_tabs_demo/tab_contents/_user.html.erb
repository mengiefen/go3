<div class="p-8">
  <div class="max-w-4xl mx-auto">
    <div class="bg-white dark:bg-slate-800 rounded-lg shadow-lg overflow-hidden">
      <div class="bg-gradient-to-r from-purple-500 to-purple-600 p-6 text-white">
        <div class="flex items-center space-x-4">
          <div class="w-16 h-16 bg-white bg-opacity-20 rounded-full flex items-center justify-center">
            <span class="text-2xl font-bold">U</span>
          </div>
          <div>
            <h1 class="text-2xl font-bold">User Profile: <%= content_id %></h1>
            <p class="text-purple-100 mt-2">User details and activity</p>
          </div>
        </div>
      </div>
      
      <div class="p-6 space-y-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <h3 class="text-lg font-semibold text-slate-900 dark:text-white mb-4">User Information</h3>
            <div class="space-y-3">
              <div>
                <label class="text-sm font-medium text-slate-600 dark:text-slate-400">Email</label>
                <p class="text-slate-900 dark:text-white">user-<%= content_id %>@example.com</p>
              </div>
              <div>
                <label class="text-sm font-medium text-slate-600 dark:text-slate-400">Role</label>
                <p class="text-slate-900 dark:text-white"><%= ['Admin', 'User', 'Manager', 'Developer'].sample %></p>
              </div>
              <div>
                <label class="text-sm font-medium text-slate-600 dark:text-slate-400">Department</label>
                <p class="text-slate-900 dark:text-white"><%= ['Engineering', 'Marketing', 'Sales', 'Support'].sample %></p>
              </div>
            </div>
          </div>
          
          <div>
            <h3 class="text-lg font-semibold text-slate-900 dark:text-white mb-4">Activity Stats</h3>
            <div class="space-y-3">
              <div class="flex justify-between">
                <span class="text-slate-600 dark:text-slate-400">Tasks Completed</span>
                <span class="font-semibold text-slate-900 dark:text-white"><%= rand(20..100) %></span>
              </div>
              <div class="flex justify-between">
                <span class="text-slate-600 dark:text-slate-400">Projects</span>
                <span class="font-semibold text-slate-900 dark:text-white"><%= rand(3..15) %></span>
              </div>
              <div class="flex justify-between">
                <span class="text-slate-600 dark:text-slate-400">Last Login</span>
                <span class="font-semibold text-slate-900 dark:text-white"><%= rand(1..24) %> hours ago</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>