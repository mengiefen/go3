<div class="min-h-screen bg-slate-50 dark:bg-slate-900">
  <!-- Page Header -->
  <div class="bg-white dark:bg-slate-800 shadow-sm border-b border-slate-200 dark:border-slate-700">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="py-6">
        <h1 class="text-2xl font-bold text-slate-900 dark:text-white">Reusable Tab Components Demo</h1>
        <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">
          Showcasing the new TabSystem, ResizablePanel, and NavigationSidebar components
        </p>
      </div>
    </div>
  </div>

  <!-- Demo Sections -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-12">
    
    <!-- Tab System Component Demo -->
    <section>
      <h2 class="text-xl font-semibold text-slate-900 dark:text-white mb-4">1. Tab System Component</h2>
      
      <div class="bg-white dark:bg-slate-800 rounded-lg shadow-lg overflow-hidden">
        <div class="p-6 border-b border-slate-200 dark:border-slate-700">
          <h3 class="text-lg font-medium text-slate-900 dark:text-white mb-2">VS Code Theme (Default)</h3>
          <p class="text-sm text-slate-600 dark:text-slate-400">
            Full-featured tab system with drag-and-drop, icons, and Chrome-style overlapping tabs
          </p>
        </div>
        
        <div class="h-96">
          <%= render TabSystem::Component.new(
            tabs: [
              { id: 'demo-1', title: 'Dashboard', active: true, icon: '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg>' },
              { id: 'demo-2', title: 'Users', active: false, icon: '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>' },
              { id: 'demo-3', title: 'Settings', active: false, icon: '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>' }
            ],
            theme: :vscode,
            show_icons: true,
            allow_reorder: true,
            controller_name: "demo-tab-system"
          ) do %>
            <div class="p-8 text-center">
              <p class="text-slate-600 dark:text-slate-400">Tab content area - each tab can load different content</p>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Chrome Theme Example -->
      <div class="mt-6 bg-white dark:bg-slate-800 rounded-lg shadow-lg overflow-hidden">
        <div class="p-6 border-b border-slate-200 dark:border-slate-700">
          <h3 class="text-lg font-medium text-slate-900 dark:text-white mb-2">Chrome Theme</h3>
          <p class="text-sm text-slate-600 dark:text-slate-400">
            Alternative theme with Chrome browser styling
          </p>
        </div>
        
        <div class="h-64">
          <%= render TabSystem::Component.new(
            tabs: [
              { id: 'chrome-1', title: 'Google', active: true },
              { id: 'chrome-2', title: 'GitHub', active: false },
              { id: 'chrome-3', title: 'Stack Overflow', active: false }
            ],
            theme: :chrome,
            show_icons: false,
            controller_name: "chrome-tab-system"
          ) do %>
            <div class="p-8 text-center">
              <p class="text-slate-600 dark:text-slate-400">Chrome-style tabs without icons</p>
            </div>
          <% end %>
        </div>
      </div>
    </section>

    <!-- Resizable Panel Component Demo -->
    <section>
      <h2 class="text-xl font-semibold text-slate-900 dark:text-white mb-4">2. Resizable Panel Component</h2>
      
      <div class="bg-white dark:bg-slate-800 rounded-lg shadow-lg overflow-hidden">
        <div class="p-6 border-b border-slate-200 dark:border-slate-700">
          <h3 class="text-lg font-medium text-slate-900 dark:text-white mb-2">Horizontal Resizable Panel</h3>
          <p class="text-sm text-slate-600 dark:text-slate-400">
            Drag the handle on the right edge to resize (min: 200px, max: 600px)
          </p>
        </div>
        
        <div class="flex h-96 bg-slate-100 dark:bg-slate-900">
          <%= render ResizablePanel::Component.new(
            direction: :horizontal,
            min_size: 200,
            max_size: 600,
            default_size: 300,
            handle_position: :end,
            classes: "bg-white dark:bg-slate-800 shadow-lg"
          ) do %>
            <div class="p-6">
              <h4 class="font-medium text-slate-900 dark:text-white mb-2">Resizable Content</h4>
              <p class="text-sm text-slate-600 dark:text-slate-400">
                This panel can be resized by dragging the handle. The size is persisted in localStorage.
              </p>
              <div class="mt-4 space-y-2">
                <div class="h-4 bg-slate-200 dark:bg-slate-700 rounded"></div>
                <div class="h-4 bg-slate-200 dark:bg-slate-700 rounded w-3/4"></div>
                <div class="h-4 bg-slate-200 dark:bg-slate-700 rounded w-1/2"></div>
              </div>
            </div>
          <% end %>
          
          <div class="flex-1 p-6">
            <h4 class="font-medium text-slate-900 dark:text-white mb-2">Main Content Area</h4>
            <p class="text-sm text-slate-600 dark:text-slate-400">
              This area expands as the resizable panel shrinks.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Navigation Sidebar Component Demo -->
    <section>
      <h2 class="text-xl font-semibold text-slate-900 dark:text-white mb-4">3. Navigation Sidebar Component</h2>
      
      <div class="bg-white dark:bg-slate-800 rounded-lg shadow-lg overflow-hidden">
        <div class="p-6 border-b border-slate-200 dark:border-slate-700">
          <h3 class="text-lg font-medium text-slate-900 dark:text-white mb-2">Tasks Navigation</h3>
          <p class="text-sm text-slate-600 dark:text-slate-400">
            Collapsible categories with search, badges, and icons
          </p>
        </div>
        
        <div class="flex h-96">
          <div class="w-72 border-r border-slate-200 dark:border-slate-700">
            <%= render NavigationSidebar::Component.new(
              navigation_type: :tasks,
              title: "TASK MANAGER",
              search_enabled: true,
              collapsible: true
            ) do %>
              <button class="w-full px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-md text-sm font-medium transition-colors">
                Create New Task
              </button>
            <% end %>
          </div>
          
          <div class="flex-1 p-6">
            <h4 class="font-medium text-slate-900 dark:text-white mb-2">Selected Item Details</h4>
            <p class="text-sm text-slate-600 dark:text-slate-400">
              Click on navigation items to see selection events. The component dispatches custom events when items are selected.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Combined Usage Example -->
    <section>
      <h2 class="text-xl font-semibold text-slate-900 dark:text-white mb-4">4. Combined Components Example</h2>
      
      <div class="bg-white dark:bg-slate-800 rounded-lg shadow-lg overflow-hidden h-[600px]">
        <div class="flex h-full">
          <!-- Resizable Navigation Sidebar -->
          <%= render ResizablePanel::Component.new(
            direction: :horizontal,
            min_size: 200,
            max_size: 400,
            default_size: 280,
            handle_position: :end,
            storage_key: "combined_demo_sidebar",
            classes: "border-r border-slate-200 dark:border-slate-700"
          ) do %>
            <%= render NavigationSidebar::Component.new(
              navigation_type: :organizations,
              search_enabled: false
            ) %>
          <% end %>
          
          <!-- Main Content with Tabs -->
          <div class="flex-1 flex flex-col">
            <%= render TabSystem::Component.new(
              tabs: [
                { id: 'combined-1', title: 'Overview', active: true },
                { id: 'combined-2', title: 'Analytics', active: false },
                { id: 'combined-3', title: 'Reports', active: false }
              ],
              show_icons: false,
              theme: :vscode
            ) do %>
              <div class="flex-1 p-8">
                <h4 class="text-xl font-semibold text-slate-900 dark:text-white mb-4">Integrated Layout Demo</h4>
                <p class="text-slate-600 dark:text-slate-400 mb-4">
                  This example shows how the components work together to create a complete application layout.
                </p>
                <div class="grid grid-cols-3 gap-4 mt-8">
                  <div class="bg-slate-100 dark:bg-slate-700 rounded-lg p-4">
                    <div class="text-2xl font-bold text-slate-900 dark:text-white">128</div>
                    <div class="text-sm text-slate-600 dark:text-slate-400">Active Users</div>
                  </div>
                  <div class="bg-slate-100 dark:bg-slate-700 rounded-lg p-4">
                    <div class="text-2xl font-bold text-slate-900 dark:text-white">24</div>
                    <div class="text-sm text-slate-600 dark:text-slate-400">Organizations</div>
                  </div>
                  <div class="bg-slate-100 dark:bg-slate-700 rounded-lg p-4">
                    <div class="text-2xl font-bold text-slate-900 dark:text-white">89%</div>
                    <div class="text-sm text-slate-600 dark:text-slate-400">Completion Rate</div>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </section>

  </div>
</div>

<style>
  /* Chrome theme styles */
  .chrome-tab-bar-container {
    @apply bg-gray-200 dark:bg-gray-800;
  }
  
  .chrome-tab-bar {
    @apply flex items-center;
  }
  
  .chrome-tab {
    @apply relative px-4 py-2 mx-1 bg-gray-100 dark:bg-gray-700 rounded-t-lg cursor-pointer;
    @apply hover:bg-white dark:hover:bg-gray-600 transition-colors;
  }
  
  .chrome-tab-active {
    @apply bg-white dark:bg-gray-900;
  }
  
  .chrome-tab-content {
    @apply flex items-center space-x-2;
  }
  
  .chrome-tab-text {
    @apply text-sm text-gray-700 dark:text-gray-300;
  }
  
  .chrome-tab-close {
    @apply ml-2 p-1 rounded hover:bg-gray-200 dark:hover:bg-gray-600;
  }
</style>