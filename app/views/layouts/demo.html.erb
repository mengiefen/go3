<!DOCTYPE html>
<html lang="<%= I18n.locale %>" class="h-full">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="tab-title" content="<%= @page_title %>">
    <title><%= content_for?(:title) ? yield(:title) : "GO3 Platform" %></title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %> 
    <%= yield :head %>
    
    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    
    
    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= yield :head_styles if content_for?(:head_styles) %>
    
    <%= yield :head_scripts if content_for?(:head_scripts) %>

    <script>
      window.customElements.define = new Proxy(window.customElements.define, {
        apply: (target, thisArg, args) => {
          if (args[0].endsWith('element2')) return
          return Reflect.apply(target, thisArg, args);
        }
      });
    </script>
    
    <meta name="turbo-cache-control" content="no-preview">
    <%= vite_client_tag %>
    <%= vite_javascript_tag 'application' %>
    <!--
      If using a TypeScript entrypoint file:
        vite_typescript_tag 'application'

      If using a .jsx or .tsx entrypoint, add the extension:
        vite_javascript_tag 'application.jsx'

      Visit the guide for more information: https://vite-ruby.netlify.app/guide/rails
    -->

  </head>
  <body class="h-full flex flex-col" data-color-mode="light" data-light-theme="light" data-dark-theme="dark">
    <header class="w-full bgColor-emphasis px-4 py-3">
      <%= render Primer::Beta::Heading.new(tag: :h1, color: :on_emphasis).with_content('HEADING') %>
    </header>
    <div class="w-full h-full flex">
      <div class="w-1/4 bgColor-emphasis color-fg-on-emphasis p-3">
        <%= render Primer::Beta::Link.new(href: demo_path, font_size: 2, display: :block, underline: true, data: { tab: :page1 }).with_content('Page 1') %>
        <%= render Primer::Beta::Link.new(href: demo_page2_path, font_size: 2, display: :block, underline: true, data: { tab: :page2 }).with_content('Page 2') %>
        <%= render Primer::Beta::Link.new(href: demo_page3_path, font_size: 2, display: :block, underline: true, data: { tab: :page3 }).with_content('Page 3') %>
      </div>
      <div
        class="w-3/4 flex flex-col"
        x-data="tabsSystem"
        @turbo:click.document="handleTurboClick"
        @turbo:frame-render="onFrameRender"
        data-param-current-tab="<%= { path: request.url, title: @page_title, key: @tab_key }.to_json %>"
      >
        <div class="flex">
          <template x-for="tab in tabs" :key="tab.path">
            <div
              class="flex gap-1 p-2 cursor-pointer bg-gray-100 opacity-50 [&.current]:opacity-100 select-none"
              :class="{ current: tab.path === currentTab.path }"
              @click="switchTab(tab)"
              role="button"
            >
              <span x-text="tab.title"></span>
              <button
                type="button"
                class="bg-gray-200 px-1 !rounded-full hover:bg-gray-300"
                @click.self="closeTab(tab)" 
                aria-label="Close tab"
              >
                &times;
              </button>
            </div>
          </template>
        </div>
        <div class="w-full" x-ref="tabContent">
          <%= yield %>
        </div>
      </div>
    </div>
  </body>
</html>
