<tr id="department_row_<%= department.id %>" class="border-b border-gray-300 hover:bg-gray-100 transition-colors department-row" data-search-department-target="row">
  <td class="flex items-center space-x-3 py-2 px-4 font-medium">
    <%= department.name %>
  </td>
  <td class="text-center">
    <%= department.abbreviation %>
  </td>
  <td>
    <%= render Navigation::MenuComponent.new do %>
      <li class="flex flex-col p-2 text-black">
        <%= link_to view_t("edit_department", action: "index", controller: "departments"), 
            edit_organization_department_path(department.organization, department), 
            class: "whitespace-nowrap w-full flex flex-start",
            data: { turbo_frame: "modal" }
        %>
      </li>
      <li class="flex flex-col p-2 text-black">
        <%= button_to view_t("delete_department", action: "index", controller: "departments"), 
            organization_department_path(department.organization, department), 
            class: "whitespace-nowrap cursor-pointer w-full flex flex-start", 
            method: :delete,
            data: { 
              confirm: "Are you sure you want to delete this department?",
              turbo_frame: "department_row_#{department.id}" 
            } 
        %>
      </li>
    <% end %>
  </td>
  <td class="text-center py-2">
    <%= department.description %>
  </td>
  <td class="text-center py-2">
    <div class="inline-flex align-center justify-center rounded-full px-4 py-2 text-md font-semibold bg-green-100 text-green-800">
      <%= department.members.count %> <%= view_t("members", action: "index", controller: "departments") %>
    </div>
  </td>
</tr>

<style>
  tr.department-row li:hover {
    background-color: silver;
  }
</style> 