wb = xlsx_package.workbook

wb.add_worksheet(name: "Departments") do |sheet|
  # Set sheet direction for RTL languages
  if current_rtl?
    sheet.sheet_view.right_to_left = true
  end

  # Add header row
  header_style = wb.styles.add_style(
    bg_color: "366092",
    fg_color: "FFFFFF",
    b: true,
    alignment: { horizontal: :center }
  )

  sheet.add_row [
    view_t("name"),
    view_t("abbreviation"),
    view_t("description"),
    view_t("members_count")
  ], style: header_style

  # Add data rows
  @departments.each do |department|
    sheet.add_row [
      department.name,
      department.abbreviation,
      department.description || "",
      department.members.count
    ]
  end

  # Auto-fit columns
  sheet.column_widths 30, 15, 40, 15
end
