<div>
  <%= form.label :name, view_t("department_name"), class: "block text-sm font-semibold text-gray-700 mb-1" %>
  <%= render Forms::TranslatableInputComponent.new(
    form: form, 
    field_name: "name", 
    primary_language: "en", 
    available_languages: ["en", "fa"]) 
  %>
</div>

<div>
  <%= form.label :abbreviation, view_t("abbreviation"), class: "block text-sm font-semibold text-gray-700 mb-1" %>
  <%= form.text_field :abbreviation, 
      id: "department_abbreviation", 
      class: "mt-1 block w-full rounded-lg border-1 border-gray-300 shadow-sm focus:border-indigo-500 text-base px-4 py-2", 
      maxlength: 4,
      required: true %>
</div>

<div>
  <%= form.label :description, view_t("description"), class: "block text-sm font-semibold text-gray-700 mb-1" %>
  <%= render Forms::TranslatableInputComponent.new(
    form: form, 
    field_name: "description", 
    primary_language: "en", 
    available_languages: ["en", "fa"]) 
  %>
</div>

<div class="flex flex-col gap-2 pt-6">
  <%= form.submit view_t("submit"), 
      class: "px-5 py-2 text-sm font-semibold text-white bg-indigo-600 border border-transparent rounded-lg shadow-sm hover:bg-indigo-700 transition width-100 cursor-pointer",
      data: { action: "modal#close"}
  %>
  <%= link_to view_t("cancel"), "", onclick: "document.getElementById('modal').innerHTML = ''", 
      class: "px-5 py-2 text-sm font-semibold text-gray-700 bg-white border border-gray-300 rounded-lg shadow-sm hover:bg-gray-50 transition text-center" 
  %>
</div>

<script>
  document.addEventListener("turbo:frame-load", function(event) {
    if (event.target.id === "modal") {
      console.log("Turbo frame loaded - initializing department form");
      initializeDepartmentForm();
    }
  });

  // Also run when script first loads in case frame is already present
  if (document.getElementById("modal")) {
    initializeDepartmentForm();
  }

  function initializeDepartmentForm() {
    // Get abbreviation input
    const abbreviationInput = document.getElementById('department_abbreviation');

    // Uppercase enforcement for abbreviation
    if (abbreviationInput) {
      abbreviationInput.addEventListener('input', function() {
        this.value = this.value.toUpperCase();
        if (this.value.length > 4) {
          this.value = this.value.substring(0, 4);
        }
      });
    }
  }
</script> 