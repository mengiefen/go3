<tr 
  class="role_row_<%= role.id %> hover:bg-gray-50 <%= additional_classes %>" 
  data-turbo-stream-target="role_row_<%= role.id %>"
  data-role-hierarchy-target="<%= additional_classes ? 'children' : ''%>"
  data-search-role-target="row"
>
  <td class="px-6 py-1 whitespace-nowrap ">
    <div class="flex items-center" style="padding-left: <%= (level || 0) * 24 %>px;">
      <!-- Fixed width container for expand/collapse button -->
      <div class="w-6 flex-shrink-0 mr-2 ">
        <% if role.children.any? %>
          <button class="text-gray-400 hover:text-gray-600 w-full flex justify-center" 
                  data-action="click->role-hierarchy#toggle"
                  data-role-id="<%= role.id %>"
                  data-role-hierarchy-target="toggle">
              <i class="fa fa-minus border border-gray-300 rounded p-1 text-xs leading-3"></i>
          </button>
        <% end %>
      </div>
      
      <!-- Role name with consistent left alignment -->
      <span class="flex-grow"><%= role.name %></span>
    </div>
  </td>
  
  <td class="px-6 py-1 whitespace-nowrap text-sm text-gray-900 w-[250px]">
    <%= role.description %>
  </td>
  
  <td class="px-6 py-1 whitespace-nowrap text-sm text-gray-900 w-[150px]">
    <%= role.department&.name %>
  </td>
  
  <td class="px-6 py-1 whitespace-nowrap text-sm text-gray-900 w-[200px]">
    <%= role.member&.name %>
  </td>
  
  <td class="px-6 py-1 whitespace-nowrap w-[100px]">
    <% if role.active? %>
      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
        <%= t('views.roles.index.active') %>
      </span>
    <% else %>
      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
        <%= t('views.roles.index.inactive') %>
      </span>
    <% end %>
  </td>
  
  <td class="px-6 py-1 whitespace-nowrap text-right text-sm font-medium w-[120px]">
    <div class="flex items-center justify-end space-x-2">
      <%= link_to assignments_organization_role_path(organization, role), 
                  class: "text-indigo-600 hover:text-indigo-900",
                  data: { turbo_frame: "modal" } do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z"></path>
        </svg>
      <% end %>
      
      <%= link_to edit_organization_role_path(organization, role), 
                  class: "text-indigo-600 hover:text-indigo-900",
                  data: { turbo_frame: "modal" } do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
        </svg>
      <% end %>
      
      <% if role.active? %>
        <%= button_to deactivate_organization_role_path(organization, role), 
                      method: :patch,
                      class: "text-yellow-600 hover:text-yellow-900",
                      form: { style: 'display: inline;' } do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728L5.636 5.636m12.728 12.728L18.364 5.636M5.636 18.364l12.728-12.728"></path>
          </svg>
        <% end %>
      <% else %>
        <%= button_to activate_organization_role_path(organization, role), 
                      method: :patch,
                      class: "text-green-600 hover:text-green-900",
                      form: { style: 'display: inline;' } do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
          </svg>
        <% end %>
      <% end %>
    </div>
  </td>
</tr>

<!-- Expandable children row -->
<% if role.children.any? %>
  <tr class="children-container children-<%= role.id %>">
    <td colspan="6" class="px-0 py-0">
      <div class="bg-gray-50 mb-2 rounded-lg">
        <table class="min-w-full">
          <% role.children.includes([:department, :children]).each do |child| %>
            <%= render partial: "roles/role_row", locals: { 
              organization: organization,
              role: child, 
              level: (level || 0) + 1, 
              additional_classes: "child-of-#{role.id}"
            } %>
          <% end %>
        </table>
      </div>
    </td>
  </tr>
<% end %>