<title><%= view_t("roles") %></title>
<div data-controller="search-role role-hierarchy" class="h-full flex flex-col">
  <div class="container mx-auto p-2 flex gap-16 items-center justify-between">
    <h2 class="text-2xl font-bold text-gray-900 tracking-tight"><%= view_t("list_of_roles") %></h2>
    <input
      type="text"
      placeholder="<%= view_t("search_placeholder") %>"
      data-search-role-target="input"
      data-action="input->search-role#filter"
      class="flex-1 bg-white px-4 py-2 border border-gray-300 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary text-sm"
    />
    
    <div class="flex items-center gap-3">
      <%= link_to raw('<i class="fas fa-file-excel"></i>'), export_organization_roles_path(format: :xlsx), 
          title: view_t("export_to_excel"),
          class: "inline-flex items-center justify-center w-10 h-10 border border-transparent text-sm font-semibold rounded-lg shadow-sm text-white bg-green-600 hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500 transition" 
      %>
      
      <%= link_to raw('<i class="fas fa-add mx-2"></i>' + view_t("add_a_new_role")), new_organization_role_path(@organization), 
          data: { turbo_frame: "modal" },
          class: "inline-flex items-center px-5 py-2.5 border border-transparent text-sm font-semibold rounded-lg shadow-sm text-white bg-indigo-500 hover:indigo-600 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition" 
      %>
    </div>
  </div>

  <%= turbo_frame_tag "modal" %>

  <div class="bg-white shadow overflow-x-hidden flex-1 overflow-y-auto">
    <%= render DataDisplay::TableComponent.new( 
      columns: [
        { label: view_t('name')},
        { label: view_t('description'), width: "250px"},
        { label: view_t('department'), width: "150px"},
        { label: view_t('current_assignee'), width: "200px"},
        { label: view_t('status'), class: 'text-center', width: "100px" },
        { label: '', width: "120px" }
      ],
      table_class_list: "table-auto",
      body_class_list: "roles_list",
      turbo_frame_target: "roles_list"
    ) do |table| %>
      <% @roles.each do |role| %>
        <% table.with_row do %>
          <%= render partial: "role_row", locals: { organization: @organization, role: role, level: 0, additional_classes: '' } %>
        <% end %>
      <% end %>
    <% end %>
  </div>
</div>
