wb = xlsx_package.workbook
wb.add_worksheet(name: "Roles") do |sheet|
  # Add header row
  sheet.add_row [
    t("views.roles.export.name"),
    t("views.roles.export.description"),
    t("views.roles.export.department"),
    t("views.roles.export.parent"),
    t("views.roles.export.current_assignee"),
    t("views.roles.export.status"),
    t("views.roles.export.created_at")
  ], style: wb.styles.add_style(b: true, bg_color: "CCCCCC")

  # Add data rows
  @roles.each do |role|
    current_assignment = role.role_assignments.active.first
    sheet.add_row [
      role.name,
      role.description,
      role.department&.name || "-",
      role.parent&.name || "-",
      current_assignment&.member&.name || "-",
      role.active? ? t("views.roles.export.active") : t("views.roles.export.inactive"),
      role.created_at.strftime("%Y-%m-%d %H:%M:%S")
    ]
  end

  # Auto-size columns
  sheet.column_widths 20, 30, 15, 15, 20, 10, 20
end
