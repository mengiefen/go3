<div class="space-y-4">
  <!-- Role Name (Translatable) -->
  <div>
    <%= form.label :name, view_t("role_name"), class: "block text-sm font-semibold text-gray-700 mb-1" %>
    <%= render Forms::TranslatableInputComponent.new(
      form: form, 
      field_name: "name", 
      primary_language: "en", 
      available_languages: ["en", "fa"]) 
    %>
  </div>

  <!-- Role Description (Translatable) -->
  <div>
    <%= form.label :description, view_t("description"), class: "block text-sm font-semibold text-gray-700 mb-1" %>
    <%= render Forms::TranslatableInputComponent.new(
      form: form, 
      field_name: "description", 
      primary_language: "en", 
      available_languages: ["en", "fa"]) 
    %>
  </div>

  <!-- Department -->
  <div>
    <%= form.label :department_id, view_t("department"), class: "block text-sm font-semibold text-gray-700 mb-1" %>
    <%= form.collection_select :department_id, 
                              @organization.departments.order(:name), 
                              :id, 
                              :name, 
                              { prompt: view_t("select_department") },
                              { class: "mt-1 block w-full rounded-lg border-1 border-gray-300 shadow-sm focus:border-indigo-500 text-base px-4 py-2" } %>
  </div>

  <!-- Parent Role -->
  <div>
    <%= form.label :parent_id, view_t("parent_role"), class: "block text-sm font-semibold text-gray-700 mb-1" %>
    <%= form.collection_select :parent_id, 
                              @organization.roles.where.not(id: @role.id).order(:name), 
                              :id, 
                              :name, 
                              { prompt: view_t("select_parent_role") },
                              { class: "mt-1 block w-full rounded-lg border-1 border-gray-300 shadow-sm focus:border-indigo-500 text-base px-4 py-2" } %>
  </div>

  <!-- Active Status -->
  <div class="flex items-center">
    <%= form.check_box :active, 
                       class: "h-4 w-4 text-indigo-600 focus:ring-indigo-500 border-gray-300 rounded" %>
    <label class="ml-2 block text-sm text-gray-900">
      <%= view_t("active") %>
    </label>
  </div>

  <!-- Form Actions -->
  <div class="flex flex-col gap-2 pt-6">
    <%= form.submit view_t("submit"), 
                    class: "px-5 py-2 text-sm font-semibold text-white bg-indigo-600 border border-transparent rounded-lg shadow-sm hover:bg-indigo-700 transition width-100 cursor-pointer",
                    data: { action: "modal#close"} %>
    <%= link_to view_t("cancel"), "#", 
                data: { action: "click->modal#close" },
                class: "px-5 py-2 text-sm font-semibold text-gray-700 bg-white border border-gray-300 rounded-lg shadow-sm hover:bg-gray-50 transition text-center" %>
  </div>
</div>
