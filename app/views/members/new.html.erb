<%= turbo_frame_tag "modal" do %>
  <%= render Ui::ModalComponent.new(id: "new_member_modal", title: view_t("create_a_new_member")) do %>
    <%= form_with(model: @member, url: organization_members_path, html: { id: "new_member_form", class: "p-4" }) do |form| %>
      <div class="mb-4">
        <%= form.label :name, view_t("full_name"), class: "block text-sm font-medium text-gray-700" %>
        <%= form.text_field :name, required: true, id: "member_name", class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
      </div>

      <div class="mb-4">
        <%= form.label :email, view_t("email"), class: "block text-sm font-medium text-gray-700" %>
        <%= form.email_field :email, id: "member_email", class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
        <p id="email_error" class="mt-1 text-sm text-red-600 hidden">Please enter a valid email address</p>
      </div>

      <div class="mb-4">
        <%= form.label :initial, view_t("initials"), class: "block text-sm font-medium text-gray-700" %>
        <%= form.text_field :initial, id: "member_initial", class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm", maxlength: 2 %>
      </div>

      <div class="mb-4">
        <%= form.label :color, view_t("color"), class: "block text-sm font-medium text-gray-700" %>
        <%= form.color_field :color, value: "#F9A8D4", class: "mt-1 block w-full h-10" %>
      </div>

      <div class="flex justify-end space-x-2 pt-4">
        <%= link_to view_t("cancel"), "", onclick: "document.getElementById('modal').innerHTML = ''", class: "px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md shadow-sm hover:bg-gray-50" %>
        <%= form.submit view_t("create"), class: "px-4 py-2 text-sm font-medium text-white bg-indigo-600 border border-transparent rounded-md shadow-sm hover:bg-indigo-700" %>
        <%= form.submit view_t("create_and_invite"), name: "invite", value: "Create and invite", id: "invite_button", disabled: true, class: "px-4 py-2 text-sm font-medium text-white bg-indigo-600 border border-transparent rounded-md shadow-sm hover:bg-indigo-700 disabled:opacity-50 disabled:cursor-not-allowed" %>
      </div>
    <% end %>
  <% end %>
  <script>
    document.addEventListener("turbo:frame-load", function(event) {
      if (event.target.id === "modal") {
        console.log("Turbo frame loaded - initializing form");
        initializeMemberForm();
      }
    });

    // Also run when script first loads in case frame is already present
    if (document.getElementById("modal")) {
      console.log("Modal frame already exists - initializing form");
      initializeMemberForm();
    }

    function initializeMemberForm() {
      console.log("Initializing member form");
      
      // Get all elements
      const nameInput = document.getElementById('member_name');
      const initialInput = document.getElementById('member_initial');
      const emailInput = document.getElementById('member_email');
      const inviteButton = document.getElementById('invite_button');
      const emailError = document.getElementById('email_error');

      // Debug: Check if all elements exist
      console.log("Form elements:", {
        nameInput,
        initialInput,
        emailInput,
        inviteButton,
        emailError
      });

      // 1. Initials generation from name
      if (nameInput && initialInput) {
        nameInput.addEventListener('blur', function() {
          if (!initialInput.value) {
            const name = this.value.trim();
            if (name.length > 0) {
              const words = name.split(/\s+/);
              let initials = '';
              
              if (words.length >= 2) {
                initials = words[0].charAt(0) + words[1].charAt(0);
              } else {
                initials = name.substring(0, 2);
              }
              
              initialInput.value = initials.toUpperCase();
            }
          }
        });
      }

      // 2. Uppercase enforcement for initials
      if (initialInput) {
        initialInput.addEventListener('input', function() {
          this.value = this.value.toUpperCase();
          if (this.value.length > 2) {
            this.value = this.value.substring(0, 2);
          }
        });
      }

      // 3. Email validation
      if (emailInput && inviteButton && emailError) {
        emailInput.addEventListener('input', function() {
          const email = this.value.trim();
          const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
          
          if (email === '') {
            inviteButton.disabled = true;
            emailError.classList.add('hidden');
          } else if (emailRegex.test(email)) {
            inviteButton.disabled = false;
            emailError.classList.add('hidden');
          } else {
            inviteButton.disabled = true;
            emailError.classList.remove('hidden');
          }
        });
      }
    }

  </script>
<% end %>

