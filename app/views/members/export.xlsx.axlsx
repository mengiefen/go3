wb = xlsx_package.workbook

wb.add_worksheet(name: "Members") do |sheet|
  # Set sheet direction for RTL languages
  if current_rtl?
    sheet.sheet_view.right_to_left = true
  end

  # Add header row
  header_style = wb.styles.add_style(
    bg_color: "366092",
    fg_color: "FFFFFF",
    b: true,
    alignment: { horizontal: :center }
  )

  sheet.add_row [
    view_t("name"),
    view_t("email"),
    view_t("status"),
    view_t("admin")
  ], style: header_style

  # Add data rows
  @members.each do |member|
    sheet.add_row [
      member.name,
      member.email,
      member.status,
      member.org_admin? ? "Yes" : "No"
    ]
  end

  # Auto-fit columns
  sheet.column_widths 30, 30, 15, 10, 20
end
