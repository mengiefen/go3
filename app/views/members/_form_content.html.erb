<div data-controller="member-form">
  <div>
    <%= form.label :name, view_t("full_name"), class: "block text-sm font-semibold text-gray-700 mb-1" %>
    <%= form.text_field :name, required: true, id: "member_name", 
        data: { member_form_target: "name" },
        class: "mt-1 block w-full rounded-lg border-1 border-gray-300 shadow-sm focus:border-indigo-500 text-base px-4 py-2" %>
  </div>

  <div>
    <%= form.label :email, view_t("email"), class: "block text-sm font-semibold text-gray-700 mb-1" %>
    <%= form.email_field :email, 
        id: "member_email", 
        data: { member_form_target: "email" },
        class: "mt-1 block w-full rounded-lg border-1  border-gray-300 shadow-sm focus:border-indigo-500 text-base px-4 py-2",
        disabled: @member.user.present?
    %>
    <p id="email_error" data-member-form-target="emailError" class="mt-1 text-sm text-red-600 hidden">Please enter a valid email address</p>
  </div>

  <div>
    <%= form.label :initial, view_t("initials"), class: "block text-sm font-semibold text-gray-700 mb-1" %>
    <%= form.text_field :initial, id: "member_initial", 
        data: { member_form_target: "initial" },
        class: "mt-1 block w-full rounded-lg border-1 border-gray-300 shadow-sm focus:border-indigo-500 text-base px-4 py-2", maxlength: 2 %>
  </div>

  <div>
    <%= form.label :color, view_t("color"), class: "block text-sm font-semibold text-gray-700 mb-1" %>
    <%= form.color_field :color, value: @member.color || random_color, class: "mt-1 block w-full h-12 rounded-lg border-1 border-gray-300 shadow-sm focus:border-indigo-500" %>
  </div>

  <div class="flex flex-col gap-2 pt-6">
    <%= form.submit view_t("submit"), 
        class: "px-5 py-2 text-sm font-semibold text-white bg-indigo-600 border border-transparent rounded-lg shadow-sm hover:bg-indigo-700 transition width-100 cursor-pointer" 
    %>
    <% if @member.user.nil? %>
      <%= form.submit view_t("submit_and_invite"), name: "invite", value: view_t("submit_and_invite"), id: "invite_button", disabled: true, 
          data: { member_form_target: "inviteButton" },
          class: "px-5 py-2 text-sm font-semibold text-white bg-indigo-600 border border-transparent rounded-lg shadow-sm hover:bg-indigo-700 transition width-100 cursor-pointer" 
      %>
    <% end %>
    <%= link_to view_t("cancel"), "#", data: { action: "click->modal#close" } , 
        class: "px-5 py-2 text-sm font-semibold text-gray-700 bg-white border border-gray-300 rounded-lg shadow-sm hover:bg-gray-50 transition text-center" 
    %>
  </div>
</div>