<div>
  <%= form.label :name, view_t("full_name"), class: "block text-sm font-semibold text-gray-700 mb-1" %>
  <%= form.text_field :name, required: true, id: "member_name", class: "mt-1 block w-full rounded-lg border-1 border-gray-300 shadow-sm focus:border-indigo-500 text-base px-4 py-2" %>
</div>

<div>
  <%= form.label :email, view_t("email"), class: "block text-sm font-semibold text-gray-700 mb-1" %>
  <%= form.email_field :email, 
      id: "member_email", 
      class: "mt-1 block w-full rounded-lg border-1  border-gray-300 shadow-sm focus:border-indigo-500 text-base px-4 py-2",
      disabled: @member.user.present?
  %>
  <p id="email_error" class="mt-1 text-sm text-red-600 hidden">Please enter a valid email address</p>
</div>

<div>
  <%= form.label :initial, view_t("initials"), class: "block text-sm font-semibold text-gray-700 mb-1" %>
  <%= form.text_field :initial, id: "member_initial", class: "mt-1 block w-full rounded-lg border-1 border-gray-300 shadow-sm focus:border-indigo-500 text-base px-4 py-2", maxlength: 2 %>
</div>

<div>
  <%= form.label :color, view_t("color"), class: "block text-sm font-semibold text-gray-700 mb-1" %>
  <%= form.color_field :color, value: @member.color || random_color, class: "mt-1 block w-full h-12 rounded-lg border-1 border-gray-300 shadow-sm focus:border-indigo-500" %>
</div>

<div class="flex flex-col gap-2 pt-6">
  <%= form.submit view_t("submit"), 
      class: "px-5 py-2 text-sm font-semibold text-white bg-indigo-600 border border-transparent rounded-lg shadow-sm hover:bg-indigo-700 transition width-100 cursor-pointer" 
  %>
  <% if @member.user.nil? %>
    <%= form.submit view_t("submit_and_invite"), name: "invite", value: view_t("submit_and_invite"), id: "invite_button", disabled: true, 
        class: "px-5 py-2 text-sm font-semibold text-white bg-indigo-600 border border-transparent rounded-lg shadow-sm hover:bg-indigo-700 transition width-100 cursor-pointer" 
    %>
  <% end %>
  <%= link_to view_t("cancel"), "", onclick: "document.getElementById('modal').innerHTML = ''", 
      class: "px-5 py-2 text-sm font-semibold text-gray-700 bg-white border border-gray-300 rounded-lg shadow-sm hover:bg-gray-50 transition text-center" 
  %>
</div>

  <script>
    document.addEventListener("turbo:frame-load", function(event) {
      if (event.target.id === "modal") {
        console.log("Turbo frame loaded - initializing form");
        initializeMemberForm();
      }
    });

    // Also run when script first loads in case frame is already present
    if (document.getElementById("modal")) {
      initializeMemberForm();
    }

    function initializeMemberForm() {
      // Get all elements
      const nameInput = document.getElementById('member_name');
      const initialInput = document.getElementById('member_initial');
      const emailInput = document.getElementById('member_email');
      const inviteButton = document.getElementById('invite_button');
      const emailError = document.getElementById('email_error');

      // 1. Initials generation from name
      if (nameInput && initialInput) {
        nameInput.addEventListener('blur', function() {
          if (!initialInput.value) {
            const name = this.value.trim();
            if (name.length > 0) {
              const words = name.split(/\s+/);
              let initials = '';
              
              if (words.length >= 2) {
                initials = words[0].charAt(0) + words[1].charAt(0);
              } else {
                initials = name.substring(0, 2);
              }
              
              initialInput.value = initials.toUpperCase();
            }
          }
        });
      }

      // 2. Uppercase enforcement for initials
      if (initialInput) {
        initialInput.addEventListener('input', function() {
          this.value = this.value.toUpperCase();
          if (this.value.length > 2) {
            this.value = this.value.substring(0, 2);
          }
        });
      }

      // 3. Email validation
      if (emailInput && inviteButton && emailError) {
        emailInput.addEventListener('input', function() {
          const email = this.value.trim();
          const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
          
          if (email === '') {
            inviteButton.disabled = true;
            emailError.classList.add('hidden');
          } else if (emailRegex.test(email)) {
            inviteButton.disabled = false;
            emailError.classList.add('hidden');
          } else {
            inviteButton.disabled = true;
            emailError.classList.remove('hidden');
          }
        });
      }
    }

  </script>