<div class="container mx-auto p-4 flex items-center justify-between"> 
  <h2> <%= view_t("list_of_members") %> </h2>
  <%= link_to view_t("add_a_new_member"), new_organization_member_path, 
            data: { turbo_frame: "modal" },
            class: "btn btn-primary" 
  %>
</div>

<%= turbo_frame_tag "modal" %>

<%= render DataDisplay::TableComponent.new( 
  columns: [
    { label: view_t('name')},
    { label: view_t('email')},
    { label: view_t('status'), class: 'text-center' }
  ],
  turbo_frame_target: "members_list"
) do |table| %>
  <% @members.each do |member| %>
    <% table.with_row do %>
      <%= render partial: "member_row", locals: { member: member } %>
    <% end %>
  <% end %>
<% end %>