<div data-controller="search-member">
  <div class="container mx-auto p-6 flex items-center justify-between">
    <h2 class="text-2xl font-bold text-gray-900 tracking-tight"><%= view_t("list_of_members") %></h2>
    <input
      type="text"
      placeholder="<%= view_t("search_placeholder") %>"
      data-search-member-target="input"
      data-action="input->search-member#filter"
      class="w-[400px] max-w-sm px-4 py-2 border border-gray-300 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary text-sm"
    />
    <%= link_to view_t("add_a_new_member"), new_organization_member_path, 
        data: { turbo_frame: "modal" },
        class: "inline-flex items-center px-5 py-2.5 border border-transparent text-sm font-semibold rounded-lg shadow-sm text-white bg-indigo-500 hover:indigo-600 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition" 
    %>
  </div>

  <%= turbo_frame_tag "modal" %>

  <div class="bg-white shadow overflow-hidden">
    <%= render DataDisplay::TableComponent.new( 
      columns: [
        { label: view_t('name')},
        { label: view_t('email')},
        { label: view_t('status'), class: 'text-center' }
      ],
      turbo_frame_target: "members_list"
    ) do |table| %>
      <% @members.each do |member| %>
        <% table.with_row do %>
          <%= render partial: "member_row", locals: { member: member } %>
        <% end %>
      <% end %>
    <% end %>
  </div>
</div>
