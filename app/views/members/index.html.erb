<div class="container mx-auto p-4 flex items-center justify-between"> 
  <h1> <%= view_t("list_of_members") %> </h1>
  <%= render(Ui::ButtonComponent.new) { view_t("add_a_new_member") } %>
</div>

<%= render DataDisplay::TableComponent.new(
  columns: [
    { label: view_t('name')},
    { label: view_t('email')},
    { label: view_t('status'), class: 'text-center' }
  ],
  rows: @members.map do |member|
    [  
      {content: member.name, class: 'text-center'},
      {content: member.email, class: 'text-center'},
      {content: member.localized_status, class: 'text-center'},
    ]
  end
) %>
