<%= turbo_frame_tag "modal" do %>
  <%= render Ui::ModalComponent.new(id: "edit_member_modal", title: view_t("edit_member")) do %>
    <%= form_with(
      model: @member, 
      url: organization_member_path(@member.organization, @member), 
      data: { action: "submit->modal#close" },
      html: { 
        id: "edit_member_form", 
        class: "space-y-2 bg-white rounded-xl"  
      }) do |form| %>
      <%= render partial: "form_content", locals: { form: form } %>
    <% end %>
  <% end %>
<% end %>

