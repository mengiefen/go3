<%= turbo_frame_tag "conversation" do %>
  <div class="h-full flex flex-col">
    <!-- Conversation Header -->
    <div class="flex-shrink-0 border-b border-gray-200 pb-4 mb-6">
      <h3 class="text-2xl font-bold text-gray-800"><%= @conversation.title(current_user) %></h3>
    </div>
    
    <!-- Messages Container -->
    <div class="flex-1 overflow-y-auto mb-6" data-controller="conversation-messages">
      <%= turbo_stream_from "conversation_user_#{current_user.id}" %>
        <%= turbo_frame_tag "messages_list" do %>
        <div class="space-y-6">
          <% @conversation.messages.each do |message| %>
            <%= render partial: "message", locals: {message: message, is_current_user: message.sender.id == current_user.id} %>
          <% end %>
        </div>
      <% end %>
    </div>
    
    <!-- Message Form -->
    <div class="flex-shrink-0 bg-gray-50 rounded-lg p-4 border border-gray-200">
      <%= render "message_form", locals: {path: organization_messages_path} %>
    </div>
  </div>
<% end %>