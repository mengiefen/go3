<div class="<%= is_current_user ? 'flex justify-end' : 'flex justify-start' %> mb-2">
  <div class="<%= is_current_user ? 'bg-blue-500 text-white' : 'bg-white text-gray-700' %> border <%= is_current_user ? 'border-blue-500' : 'border-gray-200' %> rounded-lg p-2 shadow-sm hover:shadow-md transition duration-200 max-w-xs sm:max-w-sm md:max-w-md lg:max-w-lg xl:max-w-xl">
    <div class="flex gap-2 items-center justify-between">
      <span class="font-semibold text-xs <%= is_current_user ? 'text-blue-100' : 'text-gray-400' %>">
        <%= is_current_user ? 'You' : message.sender.full_name %> 
      </span>
      <span class="text-xs <%= is_current_user ? 'text-blue-100' : 'text-gray-400' %>">
         <%= message.created_at.strftime("%b %d, %Y at %I:%M %p") %>
      </span>
    </div>
    <div class="<%= is_current_user ? 'text-white' : 'text-gray-700' %> leading-relaxed text-sm">
      <%= simple_format(message.body, class: "mb-0") %>
    </div>
  </div>
</div>