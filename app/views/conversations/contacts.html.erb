<%= turbo_frame_tag "conversation_contacts_modal" do %>
  <%= render Ui::ModalComponent.new(id: "conversation_contacts", title: "Select contact") do %>
    <%= form_with(
          url: new_organization_conversation_path(@organization), 
          method: :get,
          data: {turbo_frame: "conversation"},
          html: { 
            id: "contacts_organization_conversation_form",
            class: "space-y-2 bg-white rounded-xl"
          }) do |form| 
    %>
      <div data-controller="conversations-contacts" class="conversations-contacts flex flex-col w-full">
        <input 
          type="text" 
          placeholder="Search contacts..." 
          class="w-full p-3 mb-4 bg-gray-50 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent text-gray-800 placeholder-gray-400"
          data-action="input->conversations-contacts#search"
        />
        <ul class="max-h-96 overflow-y-auto space-y-2">
          <% @users.each do |user| %>
            <li 
              data-action="click->conversations-contacts#toggle"
              id="<%= user.id %>"
              class="p-3 border border-gray-200 rounded-lg cursor-pointer transition duration-200 hover:bg-gray-50 text-gray-700 hover:text-gray-900"
            >
              <span class="font-medium"><%= user.full_name %></span> 
            </li>
          <% end %>
        </ul>

        <input type="hidden" name="user_ids" data-conversations-contacts-target="userIds">

        <%= form.submit "Start chat", 
              class: "btn mt-4 w-full bg-blue-600 hover:bg-blue-700 text-white font-medium py-3 px-4 rounded-lg transition duration-200 disabled:opacity-50 disabled:cursor-not-allowed", 
              data: { 
                conversations_contacts_target: "submitButton",
                action: "modal#close"
              },
              disabled: true
         %>
      </div>
    <% end %>
  <% end %>
<% end %>

