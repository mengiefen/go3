<%= link_to organization_conversation_path(organization, conversation),
    data: { turbo_frame: "conversation" },
    class: "block py-2 px-4 bg-white border-b border-gray-200 hover:bg-gray-50 transition duration-150 cursor-pointer" do %>
  
  <div class="flex items-center justify-between">
    <h3 class="font-medium"><%= conversation.title(current_user) %></h3>
    <span class="text-sm text-gray-500"><%= conversation.updated_at.strftime("%m/%d") %></span>
  </div>
  
<% end %>