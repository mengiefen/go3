<div class="flex flex-col h-full bg-gray-50 dark:bg-gray-950">
  <!-- Header with search and blur effect -->
  <div class="sticky top-0 z-10 backdrop-blur-lg bg-white/90 dark:bg-gray-900/90 border-b border-gray-100 dark:border-gray-800">
    <div class="px-4 py-4">
      <h1 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">Organizations</h1>
      
      <!-- Search bar with enhanced styling -->
      <div class="relative">
        <input type="search" 
               placeholder="Search organizations..."
               value="<%= search_query %>"
               data-action="input->mobile-organizations#search"
               class="w-full pl-12 pr-4 py-3.5 bg-gray-100/80 dark:bg-gray-800/80 text-gray-900 dark:text-white rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white dark:focus:bg-gray-800 transition-all duration-200 text-base">
        <svg class="absolute left-4 top-4 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
      </div>
    </div>
    
    <!-- Filter chips with better styling -->
    <div class="px-4 pb-3 flex space-x-2 overflow-x-auto scrollbar-hide">
      <button class="px-4 py-2 bg-gradient-to-r from-blue-500 to-blue-600 text-white rounded-full text-sm font-semibold whitespace-nowrap shadow-sm">
        All (<%= organizations.size %>)
      </button>
      <button class="px-4 py-2 bg-white dark:bg-gray-800 text-gray-600 dark:text-gray-300 rounded-full text-sm font-medium whitespace-nowrap shadow-sm hover:shadow-md transition-all duration-200">
        Active
      </button>
      <button class="px-4 py-2 bg-white dark:bg-gray-800 text-gray-600 dark:text-gray-300 rounded-full text-sm font-medium whitespace-nowrap shadow-sm hover:shadow-md transition-all duration-200">
        Recent
      </button>
      <button class="px-4 py-2 bg-white dark:bg-gray-800 text-gray-600 dark:text-gray-300 rounded-full text-sm font-medium whitespace-nowrap shadow-sm hover:shadow-md transition-all duration-200">
        Favorites
      </button>
    </div>
  </div>
  
  <!-- Organizations list -->
  <div class="flex-1 overflow-y-auto" data-mobile-organizations-target="list">
    <% if filtered_organizations.empty? %>
      <!-- Empty state -->
      <div class="flex flex-col items-center justify-center h-full px-8 py-12">
        <div class="w-20 h-20 bg-gray-200 dark:bg-gray-700 rounded-full flex items-center justify-center mb-4">
          <svg class="w-10 h-10 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
          </svg>
        </div>
        <h3 class="text-lg font-medium text-gray-900 dark:text-white mb-1">No organizations found</h3>
        <p class="text-sm text-gray-500 dark:text-gray-400 text-center">
          <% if search_query.present? %>
            Try adjusting your search terms
          <% else %>
            Get started by creating your first organization
          <% end %>
        </p>
      </div>
    <% else %>
      <div class="px-4 py-4 space-y-4">
        <% filtered_organizations.each do |org| %>
          <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm hover:shadow-lg overflow-hidden transform transition-all duration-200 active:scale-[0.98] cursor-pointer"
               data-action="click->mobile-organizations#selectOrg"
               data-org-id="<%= org[:id] %>">
            <div class="p-5">
              <div class="flex items-start space-x-4">
                <!-- Organization avatar with enhanced styling -->
                <div class="flex-shrink-0">
                  <% if org[:logo_url] %>
                    <img src="<%= org[:logo_url] %>" alt="<%= org[:name] %>" class="w-14 h-14 rounded-xl object-cover shadow-md">
                  <% else %>
                    <div class="w-14 h-14 bg-gradient-to-br from-blue-500 to-indigo-600 rounded-xl flex items-center justify-center shadow-lg shadow-blue-500/20">
                      <span class="text-white font-bold text-base"><%= org_initials(org[:name]) %></span>
                    </div>
                  <% end %>
                </div>
                
                <!-- Organization info -->
                <div class="flex-1 min-w-0">
                  <div class="flex items-start justify-between">
                    <div class="flex-1">
                      <h3 class="text-lg font-semibold text-gray-900 dark:text-white truncate">
                        <%= org[:name] %>
                        <% if org[:id] == active_org_id %>
                          <span class="ml-2 inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-gradient-to-r from-blue-500 to-blue-600 text-white">
                            Active
                          </span>
                        <% end %>
                      </h3>
                      <% if org[:description] %>
                        <p class="text-sm text-gray-600 dark:text-gray-400 mt-1 line-clamp-2">
                          <%= org[:description] %>
                        </p>
                      <% end %>
                    </div>
                    
                    <!-- Action button with better styling -->
                    <button class="ml-3 p-2 rounded-xl hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors"
                            data-action="click->mobile-organizations#showActions stop"
                            data-org-id="<%= org[:id] %>">
                      <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z"></path>
                      </svg>
                    </button>
                  </div>
                  
                  <!-- Meta info with enhanced styling -->
                  <div class="flex items-center space-x-4 mt-3">
                    <span class="flex items-center text-sm text-gray-600 dark:text-gray-400 font-medium">
                      <svg class="w-4 h-4 mr-1.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
                      </svg>
                      <%= format_member_count(org[:member_count] || 0) %>
                    </span>
                    <% if org[:status] %>
                      <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold <%= org[:status] == 'active' ? 'bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-400' : 'bg-gray-100 text-gray-800 dark:bg-gray-800 dark:text-gray-400' %>">
                        <%= org[:status].capitalize %>
                      </span>
                    <% end %>
                    <% if org[:favorite] %>
                      <svg class="w-4 h-4 text-yellow-500" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
                      </svg>
                    <% end %>
                  </div>
                </div>
              </div>
            </div>
            
            <!-- Quick actions with gradient hover -->
            <div class="flex border-t border-gray-100 dark:border-gray-700">
              <button class="flex-1 py-3.5 text-sm font-semibold text-gray-700 dark:text-gray-300 hover:bg-gradient-to-r hover:from-gray-50 hover:to-gray-100 dark:hover:from-gray-800 dark:hover:to-gray-700 transition-all duration-200">
                View Details
              </button>
              <button class="flex-1 py-3.5 text-sm font-semibold text-blue-600 dark:text-blue-400 hover:bg-gradient-to-r hover:from-blue-50 hover:to-blue-100 dark:hover:from-blue-900/20 dark:hover:to-blue-800/20 transition-all duration-200 border-l border-gray-100 dark:border-gray-700">
                Switch to Org
              </button>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
  
  <!-- Floating action button with enhanced styling -->
  <% if can_create %>
    <button class="fixed bottom-24 right-4 w-14 h-14 bg-gradient-to-br from-blue-500 to-blue-600 text-white rounded-full shadow-xl shadow-blue-500/25 flex items-center justify-center hover:shadow-2xl hover:shadow-blue-500/30 active:scale-90 transition-all duration-200"
            data-action="click->mobile-organizations#createNew">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
      </svg>
    </button>
  <% end %>
</div>

<style>
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
  
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>