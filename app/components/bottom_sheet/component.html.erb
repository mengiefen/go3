<!-- Bottom Sheet Component -->
<div class="lg:hidden">
  <!-- Backdrop -->
  <div class="fixed inset-0 bg-black bg-opacity-50 z-40 opacity-0 pointer-events-none transition-opacity duration-300"
       data-bottom-sheet-target="backdrop"
       data-action="click->bottom-sheet#close"
       id="<%= id %>-backdrop">
  </div>
  
  <!-- Sheet -->
  <div class="<%= container_classes %>"
       data-controller="bottom-sheet"
       data-bottom-sheet-dismissible-value="<%= dismissible %>"
       id="<%= id %>">
    <div class="<%= sheet_classes %>">
      <!-- Handle -->
      <% if show_handle %>
        <div class="flex justify-center pt-4 pb-2" data-action="touchstart->bottom-sheet#handleTouchStart touchmove->bottom-sheet#handleTouchMove touchend->bottom-sheet#handleTouchEnd">
          <div class="w-12 h-1 bg-gray-300 dark:bg-gray-700 rounded-full"></div>
        </div>
      <% end %>
      
      <!-- Header -->
      <% if header %>
        <div class="px-4 pb-4 border-b border-gray-200 dark:border-gray-800">
          <%= header %>
        </div>
      <% end %>
      
      <!-- Content -->
      <div class="flex-1 overflow-y-auto overscroll-contain">
        <% if content %>
          <%= content %>
        <% else %>
          <div class="p-4">
            <p class="text-gray-500">No content</p>
          </div>
        <% end %>
      </div>
      
      <!-- Actions -->
      <% if actions %>
        <div class="p-4 border-t border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900">
          <%= actions %>
        </div>
      <% end %>
    </div>
  </div>
</div>