<!-- Bottom navigation for mobile -->
<nav class="<%= container_classes %>" data-controller="bottom-navigation">
  <div class="grid grid-cols-<%= items_to_render.size %> h-16">
    <% items_to_render.each do |item| %>
      <button 
        class="flex flex-col items-center justify-center space-y-1 relative <%= active_item == item[:id] ? 'text-blue-600 dark:text-blue-400' : 'text-slate-600 dark:text-slate-400' %> hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
        data-action="click->bottom-navigation#navigate"
        data-bottom-navigation-item-param="<%= item[:id] %>">
        
        <!-- Icon with optional badge -->
        <div class="relative">
          <%= item[:icon].html_safe %>
          <% if show_badges && item[:badge] %>
            <span class="absolute -top-1 -right-1 min-w-[18px] h-[18px] flex items-center justify-center text-xs bg-red-500 text-white rounded-full px-1">
              <%= item[:badge] %>
            </span>
          <% end %>
        </div>
        
        <!-- Label -->
        <span class="text-xs font-medium"><%= item[:label] %></span>
        
        <!-- Active indicator -->
        <% if active_item == item[:id] %>
          <span class="absolute top-0 left-1/2 transform -translate-x-1/2 w-12 h-0.5 bg-blue-600 dark:bg-blue-400 rounded-full"></span>
        <% end %>
      </button>
    <% end %>
  </div>
</nav>