<div class="flex flex-col h-full bg-gray-50 dark:bg-gray-950">
  <!-- Header -->
  <div class="sticky top-0 z-10 backdrop-blur-lg bg-white/90 dark:bg-gray-900/90 border-b border-gray-100 dark:border-gray-800">
    <div class="px-4 py-4">
      <h1 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">Team</h1>
      
      <!-- Department tabs -->
      <div class="flex space-x-2 overflow-x-auto scrollbar-hide -mx-4 px-4">
        <button class="px-4 py-2 bg-gradient-to-r from-blue-500 to-blue-600 text-white rounded-full text-sm font-semibold whitespace-nowrap shadow-sm">
          All Members (<%= team_members.size %>)
        </button>
        <% departments.each do |dept| %>
          <button class="px-4 py-2 bg-white dark:bg-gray-800 text-gray-600 dark:text-gray-300 rounded-full text-sm font-medium whitespace-nowrap shadow-sm hover:shadow-md transition-all duration-200">
            <%= dept[:name] %> (<%= dept[:member_count] %>)
          </button>
        <% end %>
      </div>
    </div>
  </div>
  
  <!-- Team members list -->
  <div class="flex-1 overflow-y-auto">
    <div class="px-4 py-4 space-y-4">
      <% team_members.each do |member| %>
        <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm hover:shadow-lg overflow-hidden transform transition-all duration-200 active:scale-[0.98] cursor-pointer">
          <div class="p-5">
            <div class="flex items-center space-x-4">
              <!-- Member avatar with status -->
              <div class="relative flex-shrink-0">
                <% if member[:avatar_url] %>
                  <img src="<%= member[:avatar_url] %>" alt="<%= member[:name] %>" class="w-14 h-14 rounded-xl object-cover shadow-md">
                <% else %>
                  <div class="w-14 h-14 bg-gradient-to-br from-purple-500 to-pink-600 rounded-xl flex items-center justify-center shadow-lg shadow-purple-500/20">
                    <span class="text-white font-bold text-base"><%= member_initials(member[:name]) %></span>
                  </div>
                <% end %>
                <!-- Status indicator -->
                <div class="absolute bottom-0 right-0 w-4 h-4 <%= status_color(member_status(member)) %> rounded-full border-2 border-white dark:border-gray-800"></div>
              </div>
              
              <!-- Member info -->
              <div class="flex-1 min-w-0">
                <div class="flex items-start justify-between">
                  <div class="flex-1">
                    <h3 class="text-lg font-semibold text-gray-900 dark:text-white">
                      <%= member[:name] %>
                      <% if member[:id] == current_user&.[](:id) %>
                        <span class="ml-2 text-xs font-normal text-gray-500">(You)</span>
                      <% end %>
                    </h3>
                    <p class="text-sm text-gray-600 dark:text-gray-400"><%= member[:role] || 'Team Member' %></p>
                    <% if member[:department] %>
                      <p class="text-sm text-gray-500 dark:text-gray-500 mt-0.5"><%= member[:department] %></p>
                    <% end %>
                  </div>
                  
                  <!-- Action buttons -->
                  <div class="flex items-center space-x-2">
                    <button class="p-2 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors">
                      <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
                      </svg>
                    </button>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>

<style>
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
</style>