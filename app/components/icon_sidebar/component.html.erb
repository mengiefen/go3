<div class="w-16 bg-slate-100 dark:bg-slate-900 flex flex-col items-center py-4 space-y-4 shadow-lg"
     data-controller="<%= controller_name %>">
  <!-- Logo/Home -->
  <div class="mb-4">
    <button class="p-2 rounded-lg hover:bg-slate-200 dark:hover:bg-slate-800 transition-colors"
            data-action="click-><%= controller_name %>#goHome">
      <svg class="w-6 h-6 text-slate-700 dark:text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
      </svg>
    </button>
  </div>
  
  <!-- Navigation Items -->
  <% items.each do |item| %>
    <button class="relative p-3 rounded-lg transition-all duration-200 group <%= active?(item[:id]) ? 'bg-blue-500 text-white' : 'hover:bg-slate-200 dark:hover:bg-slate-800 text-slate-600 dark:text-slate-400' %>"
            data-action="click-><%= controller_name %>#selectSidebar"
            data-item-id="<%= item[:id] %>"
            data-sidebar-type="<%= item[:sidebar_type] %>"
            title="<%= item[:label] %>">
      <%= icon_svg(item[:icon]).html_safe %>
      
      <!-- Active indicator -->
      <% if active?(item[:id]) %>
        <div class="absolute left-0 top-1/2 -translate-y-1/2 w-1 h-8 bg-blue-500 rounded-r-full -ml-4"></div>
      <% end %>
      
      <!-- Tooltip -->
      <div class="absolute left-full ml-2 px-2 py-1 bg-slate-900 dark:bg-slate-700 text-white text-xs rounded whitespace-nowrap opacity-0 group-hover:opacity-100 pointer-events-none transition-opacity z-50">
        <%= item[:label] %>
      </div>
    </button>
  <% end %>
  
  <!-- Spacer -->
  <div class="flex-1"></div>
  
  <!-- Bottom Actions -->
  <div class="space-y-4">
    <!-- Help -->
    <button class="p-3 rounded-lg hover:bg-slate-200 dark:hover:bg-slate-800 text-slate-600 dark:text-slate-400 transition-colors"
            title="Help">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
      </svg>
    </button>
    
    <!-- User Avatar -->
    <button class="w-10 h-10 bg-gradient-to-br from-blue-400 to-blue-600 rounded-full flex items-center justify-center text-sm font-medium text-white"
            title="User Profile">
      U
    </button>
  </div>
</div>