<div data-controller="translatable-input" 
     data-translatable-input-modal-value="<%= @modal_id %>"
     data-translatable-input-primary-language-value="<%= @primary_language %>">
  <div class="flex items-center gap-2">
    <%= @form.fields_for @field_name do |field_form| %>
      <%= field_form.text_field @primary_language, 
          value: get_translation_value(@primary_language),
          class: "mt-1 block w-full rounded-lg border-1 border-gray-300 shadow-sm focus:border-indigo-500 text-base px-4 py-2",
          placeholder: "#{@field_name.humanize} (#{@primary_language.upcase})" %>
    <% end %>
    
    <% unless single_language? %>
      <i class="fa fa-language cursor-pointer text-blue-500 hover:text-blue-700" 
         data-action="click->translatable-input#showModal"
         title="Add translations"></i>
    <% end %>
  </div>

  <!-- Translation Modal -->
  <% unless single_language? %>
    <%= render Ui::ModalComponent.new(
      id: @modal_id,
      title: "Add translations for #{@field_name}",
      hidden: true
    ) do %>
      <div class="flex flex-col space-y-4">
        <%= @form.fields_for @field_name do |field_form| %>
          <% @available_languages.each do |language| %>
            <div class="flex flex-col">
              <label class="font-medium text-gray-700 mb-1">
                <%= language.upcase %>
              </label>
              <%= field_form.text_field language, 
                  value: get_translation_value(language),
                  class: "mt-1 block w-full rounded-lg border-1 border-gray-300 shadow-sm focus:border-indigo-500 text-base px-4 py-2",
                  placeholder: "Enter #{@field_name.humanize} in #{language.upcase}" %>
            </div>
          <% end %>
        <% end %>
        
        <div class="flex justify-end mt-6">
          <button type="button" 
                  class="bg-blue-500 text-white px-4 py-2 rounded hover:bg-blue-600"
                  data-action="click->modal#close">
            Done
          </button>
        </div>
      </div>
    <% end %>
  <% end %>
</div>