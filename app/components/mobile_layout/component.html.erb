<!-- Professional Mobile Layout -->
<div class="<%= container_classes %>" data-controller="mobile-layout">
  <!-- Search Bar (Sticky) with iOS-style blur -->
  <% if show_search %>
    <div class="sticky top-0 z-20 backdrop-blur-lg bg-white/90 dark:bg-gray-900/90 border-b border-gray-100 dark:border-gray-800" data-mobile-layout-target="searchBar">
      <div class="px-4 py-3">
        <div class="relative">
          <input 
            type="search" 
            placeholder="Search everything..."
            class="w-full pl-12 pr-4 py-3.5 bg-gray-100/80 dark:bg-gray-800/80 rounded-xl text-base placeholder-gray-500 dark:placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white dark:focus:bg-gray-800 transition-all duration-200"
            data-action="input->mobile-layout#search">
          <svg class="absolute left-4 top-4 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </div>
      </div>
    </div>
  <% end %>
  
  <!-- Main Content Area -->
  <main class="pb-20">
    <% if main_content %>
      <%= main_content %>
    <% else %>
      <!-- Default content -->
      <div class="p-4">
        <p class="text-gray-500">No content</p>
      </div>
    <% end %>
  </main>
  
  <!-- FAB (Floating Action Button) with enhanced shadow and animation -->
  <button class="fixed bottom-24 right-4 w-14 h-14 bg-gradient-to-br from-blue-500 to-blue-600 text-white rounded-full shadow-xl shadow-blue-500/25 flex items-center justify-center hover:shadow-2xl hover:shadow-blue-500/30 active:scale-90 transition-all duration-200 z-10" 
          data-action="click->mobile-layout#primaryAction">
    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
    </svg>
  </button>
  
  <!-- Bottom Navigation with iOS-style blur -->
  <nav class="fixed bottom-0 left-0 right-0 backdrop-blur-lg bg-white/90 dark:bg-gray-900/90 border-t border-gray-200/50 dark:border-gray-800/50 z-20">
    <div class="grid grid-cols-5 h-16">
      <!-- Home -->
      <button class="relative flex flex-col items-center justify-center space-y-0.5 transition-all duration-200 <%= active_tab == 'home' ? 'text-blue-500' : 'text-gray-500 dark:text-gray-400' %>"
              data-action="click->mobile-layout#navigate"
              data-mobile-layout-tab-param="home">
        <% if active_tab == 'home' %>
          <div class="absolute inset-0 flex items-center justify-center">
            <div class="w-12 h-12 bg-blue-500/10 rounded-xl"></div>
          </div>
        <% end %>
        <svg class="w-6 h-6 relative z-10 <%= active_tab == 'home' ? 'scale-110' : '' %> transition-transform duration-200" fill="<%= active_tab == 'home' ? 'currentColor' : 'none' %>" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="<%= active_tab == 'home' ? '2.5' : '2' %>" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
        </svg>
        <span class="text-[10px] font-medium relative z-10 <%= active_tab == 'home' ? 'font-semibold' : '' %>">Home</span>
      </button>
      
      <!-- Organizations -->
      <button class="relative flex flex-col items-center justify-center space-y-0.5 transition-all duration-200 <%= active_tab == 'orgs' ? 'text-blue-500' : 'text-gray-500 dark:text-gray-400' %>"
              data-action="click->mobile-layout#navigate"
              data-mobile-layout-tab-param="orgs">
        <% if active_tab == 'orgs' %>
          <div class="absolute inset-0 flex items-center justify-center">
            <div class="w-12 h-12 bg-blue-500/10 rounded-xl"></div>
          </div>
        <% end %>
        <svg class="w-6 h-6 relative z-10 <%= active_tab == 'orgs' ? 'scale-110' : '' %> transition-transform duration-200" fill="<%= active_tab == 'orgs' ? 'currentColor' : 'none' %>" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="<%= active_tab == 'orgs' ? '2.5' : '2' %>" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
        </svg>
        <span class="text-[10px] font-medium relative z-10 <%= active_tab == 'orgs' ? 'font-semibold' : '' %>">Orgs</span>
      </button>
      
      <!-- Tasks -->
      <button class="relative flex flex-col items-center justify-center space-y-0.5 transition-all duration-200 <%= active_tab == 'tasks' ? 'text-blue-500' : 'text-gray-500 dark:text-gray-400' %>"
              data-action="click->mobile-layout#navigate"
              data-mobile-layout-tab-param="tasks">
        <% if active_tab == 'tasks' %>
          <div class="absolute inset-0 flex items-center justify-center">
            <div class="w-12 h-12 bg-blue-500/10 rounded-xl"></div>
          </div>
        <% end %>
        <svg class="w-6 h-6 relative z-10 <%= active_tab == 'tasks' ? 'scale-110' : '' %> transition-transform duration-200" fill="<%= active_tab == 'tasks' ? 'currentColor' : 'none' %>" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="<%= active_tab == 'tasks' ? '2.5' : '2' %>" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path>
        </svg>
        <span class="text-[10px] font-medium relative z-10 <%= active_tab == 'tasks' ? 'font-semibold' : '' %>">Tasks</span>
      </button>
      
      <!-- Team -->
      <button class="relative flex flex-col items-center justify-center space-y-0.5 transition-all duration-200 <%= active_tab == 'team' ? 'text-blue-500' : 'text-gray-500 dark:text-gray-400' %>"
              data-action="click->mobile-layout#navigate"
              data-mobile-layout-tab-param="team">
        <% if active_tab == 'team' %>
          <div class="absolute inset-0 flex items-center justify-center">
            <div class="w-12 h-12 bg-blue-500/10 rounded-xl"></div>
          </div>
        <% end %>
        <svg class="w-6 h-6 relative z-10 <%= active_tab == 'team' ? 'scale-110' : '' %> transition-transform duration-200" fill="<%= active_tab == 'team' ? 'currentColor' : 'none' %>" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="<%= active_tab == 'team' ? '2.5' : '2' %>" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
        </svg>
        <span class="text-[10px] font-medium relative z-10 <%= active_tab == 'team' ? 'font-semibold' : '' %>">Team</span>
      </button>
      
      <!-- More -->
      <button class="relative flex flex-col items-center justify-center space-y-0.5 transition-all duration-200 <%= active_tab == 'more' ? 'text-blue-500' : 'text-gray-500 dark:text-gray-400' %>"
              data-action="click->mobile-layout#navigate"
              data-mobile-layout-tab-param="more">
        <% if active_tab == 'more' %>
          <div class="absolute inset-0 flex items-center justify-center">
            <div class="w-12 h-12 bg-blue-500/10 rounded-xl"></div>
          </div>
        <% end %>
        <svg class="w-6 h-6 relative z-10 <%= active_tab == 'more' ? 'scale-110' : '' %> transition-transform duration-200" fill="<%= active_tab == 'more' ? 'currentColor' : 'none' %>" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="<%= active_tab == 'more' ? '2.5' : '2' %>" d="M5 12h.01M12 12h.01M19 12h.01M6 12a1 1 0 11-2 0 1 1 0 012 0zm7 0a1 1 0 11-2 0 1 1 0 012 0zm7 0a1 1 0 11-2 0 1 1 0 012 0z"></path>
        </svg>
        <span class="text-[10px] font-medium relative z-10 <%= active_tab == 'more' ? 'font-semibold' : '' %>">More</span>
      </button>
    </div>
  </nav>
</div>