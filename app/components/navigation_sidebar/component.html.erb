<div class="w-full h-full bg-white dark:bg-slate-800 text-slate-900 dark:text-white flex flex-col <%= classes %>" 
     <%= tag.attributes(controller_attributes) %>>
  
  <!-- Header -->
  <div class="p-4 border-b border-slate-200 dark:border-slate-700">
    <h2 class="text-xs font-semibold uppercase tracking-wider text-slate-600 dark:text-slate-400">
      <%= title %>
    </h2>
    
    <% if search_enabled %>
      <div class="mt-3">
        <input type="text" 
               placeholder="Search..."
               class="w-full px-3 py-1.5 text-sm bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400"
               data-<%= controller_name %>-target="searchInput"
               data-action="input-><%= controller_name %>#search">
      </div>
    <% end %>
  </div>
  
  <!-- Navigation Categories -->
  <div class="flex-1 overflow-y-auto">
    <% categories.each_with_index do |category, index| %>
      <div class="navigation-category" 
           data-<%= controller_name %>-target="category"
           data-category-index="<%= index %>">
        
        <!-- Category Header -->
        <% if collapsible %>
          <button class="w-full px-4 py-2 flex items-center justify-between text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 transition-colors"
                  data-action="click-><%= controller_name %>#toggleCategory"
                  data-category-index="<%= index %>">
            <div class="flex items-center space-x-2">
              <% if category[:icon] %>
                <span class="text-slate-400 dark:text-slate-500">
                  <%= icon_svg(category[:icon]).html_safe %>
                </span>
              <% end %>
              <span><%= category[:name] %></span>
            </div>
            <span class="transform transition-transform duration-200 <%= category[:collapsed] ? '' : 'rotate-90' %>"
                  data-<%= controller_name %>-target="chevron">
              <%= icon_svg('chevron-right').html_safe %>
            </span>
          </button>
        <% else %>
          <div class="px-4 py-2 text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">
            <div class="flex items-center space-x-2">
              <% if category[:icon] %>
                <span class="text-slate-400 dark:text-slate-500">
                  <%= icon_svg(category[:icon]).html_safe %>
                </span>
              <% end %>
              <span><%= category[:name] %></span>
            </div>
          </div>
        <% end %>
        
        <!-- Category Items -->
        <div class="<%= 'hidden' if category[:collapsed] %>" 
             data-<%= controller_name %>-target="categoryContent">
          <% category[:items].each do |item| %>
            <div class="block px-6 py-2 text-sm text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 hover:text-slate-900 dark:hover:text-white transition-colors navigation-item cursor-pointer"
                 data-action="click-><%= controller_name %>#openTab"
                 data-content-type="<%= item[:type] %>"
                 data-content-id="<%= item[:filter] || item[:id] %>"
                 data-content-name="<%= item[:name] %>">
              <div class="flex items-center justify-between">
                <span><%= item[:name] %></span>
                <% if item[:badge] %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium 
                               <%= item[:badge] == 'new' ? 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200' : 'bg-slate-100 text-slate-700 dark:bg-slate-700 dark:text-slate-300' %>">
                    <%= item[:badge] %>
                  </span>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
  
  <!-- Footer Actions (optional) -->
  <% if content? %>
    <div class="p-4 border-t border-slate-200 dark:border-slate-700">
      <%= content %>
    </div>
  <% end %>
</div>