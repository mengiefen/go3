<div class="h-96">
  <%= render TabSystem::Component.new(
    theme: theme,
    show_icons: show_icons,
    show_close_buttons: show_close_buttons,
    allow_reorder: allow_reorder,
    show_actions_menu: show_actions_menu,
    controller_name: "tab-system"
  ) %>
</div>

<script type="text/javascript">
  // Add some sample tabs for demonstration
  document.addEventListener('DOMContentLoaded', function() {
    const tabSystemElement = document.querySelector('[data-controller*="tab-system"]');
    if (tabSystemElement) {
      const tabSystemController = window.Stimulus.getControllerForElementAndIdentifier(tabSystemElement, 'tab-system');
      
      if (tabSystemController) {
        // Add sample tabs after a brief delay to ensure controller is ready
        setTimeout(() => {
          const sampleTabs = [
            { id: 'tab-sample-dashboard-1', title: 'Dashboard', icon: '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"></path></svg>' },
            { id: 'tab-sample-users-2', title: 'User Management with Very Long Title That Should Be Truncated', icon: '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>' },
            { id: 'tab-sample-reports-3', title: 'Reports', icon: '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>' },
            { id: 'tab-sample-settings-4', title: 'Settings', icon: '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>' }
          ];

          sampleTabs.forEach((tab, index) => {
            tabSystemController.addTab(tab.id, tab.title, <%= show_icons %> ? tab.icon : null);
            
            // Add sample content
            const contentContainer = document.getElementById(tab.id);
            if (contentContainer) {
              contentContainer.innerHTML = `
                <div class="p-6">
                  <h2 class="text-xl font-semibold mb-4">${tab.title}</h2>
                  <p class="text-slate-600 dark:text-slate-400">
                    This is sample content for the ${tab.title} tab. In a real application, 
                    this would be loaded dynamically via Turbo Frames.
                  </p>
                  <div class="mt-4 p-4 bg-slate-50 dark:bg-slate-800 rounded-lg">
                    <h3 class="font-medium mb-2">Tab ID: ${tab.id}</h3>
                    <p class="text-sm text-slate-500 dark:text-slate-400">
                      This demonstrates how content is organized within each tab container.
                    </p>
                  </div>
                </div>
              `;
            }
          });

          // Activate the first tab
          if (sampleTabs.length > 0) {
            tabSystemController.setActiveTab(sampleTabs[0].id);
          }
        }, 100);
      }
    }
  });
</script>